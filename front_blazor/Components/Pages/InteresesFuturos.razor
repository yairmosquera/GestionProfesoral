@page "/intereses-futuros"
@rendermode InteractiveServer

@using System.Text.Json
@using FrontGestion.Servicios
@inject ServicioInteresFuturo Servicio
@inject ServicioDocente ServicioDocentes
@inject ServicioTerminoClave ServicioTerminos
@inject ILogger<InteresesFuturos> Logger

<PageTitle>Intereses Futuros</PageTitle>

<h1>Intereses Futuros</h1>
<p class="text-muted">Asocia docentes con términos clave de interés futuro.</p>

@if (!string.IsNullOrWhiteSpace(mensaje))
{
    <div class="alert @(esError ? "alert-danger" : "alert-success")">@mensaje</div>
}

<div class="card mb-4">
    <div class="card-body">
        <h4 class="mb-3">@(editando ? "Editar interés futuro" : "Registrar interés futuro")</h4>
        <div class="row g-3">
            <div class="col-md-6">
                <label class="form-label">Docente</label>
                <select class="form-select" @bind="formulario.Docente" disabled="@guardando">
                    <option value="0">Seleccione un docente</option>
                    @if (editando && docentes.All(x => x.Cedula != docenteOriginal))
                    {
                        <option value="@docenteOriginal">@NombreDocente(docenteOriginal) (actual)</option>
                    }
                    @foreach (var docente in docentes)
                    {
                        <option value="@docente.Cedula">
                            @docente.Nombres @docente.Apellidos - @docente.Cedula
                        </option>
                    }
                </select>
            </div>
            <div class="col-md-6">
                <label class="form-label">Término clave</label>
                <select class="form-select" @bind="formulario.TerminoClave" disabled="@guardando">
                    <option value="">Seleccione un término</option>
                    @if (editando && terminos.All(x => x.Termino != terminoClaveOriginal))
                    {
                        <option value="@terminoClaveOriginal">@terminoClaveOriginal (actual)</option>
                    }
                    @foreach (var termino in terminos)
                    {
                        <option value="@termino.Termino">@termino.Termino</option>
                    }
                </select>
            </div>
        </div>
        <div class="mt-3">
            <button class="btn btn-primary me-2" disabled="@guardando" @onclick="Guardar">
                @(guardando ? "Guardando..." : editando ? "Actualizar" : "Guardar")
            </button>
            @if (editando)
            {
                <button class="btn btn-secondary" disabled="@guardando" @onclick="Limpiar">Cancelar</button>
            }
        </div>
    </div>
</div>

<h4 class="mb-3">Intereses registrados</h4>
@if (cargando)
{
    <p>Cargando intereses...</p>
}
else if (intereses.Count == 0)
{
    <div class="alert alert-info">No hay intereses futuros registrados.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-bordered align-middle">
            <thead class="table-light">
                <tr><th>Docente</th><th>Término clave</th><th>Acciones</th></tr>
            </thead>
            <tbody>
                @foreach (var interes in intereses)
                {
                    <tr>
                        <td>@NombreDocente(interes.Docente)</td>
                        <td>@interes.TerminoClave</td>
                        <td>
                            <button class="btn btn-warning btn-sm me-1"
                                    @onclick="() => Editar(interes)">
                                Editar
                            </button>
                            <button class="btn btn-danger btn-sm"
                                    @onclick="() => Eliminar(interes.Docente, interes.TerminoClave)">
                                Retirar
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private List<DocenteDto> docentes = new();
    private List<TerminoClaveDto> terminos = new();
    private List<InteresFuturoDto> intereses = new();
    private InteresFuturoDto formulario = new();
    private string mensaje = string.Empty;
    private bool esError;
    private bool cargando = true;
    private bool guardando;
    private bool editando;
    private int docenteOriginal;
    private string terminoClaveOriginal = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            docentes = await ServicioDocentes.Listar();
            terminos = await ServicioTerminos.ObtenerTodosAsync();
            intereses = await Servicio.Listar();
        }
        catch (Exception ex) when (ex is HttpRequestException or JsonException)
        {
            Logger.LogError(ex, "No fue posible cargar los intereses futuros.");
            MostrarError("No fue posible cargar los docentes, términos o intereses futuros.");
        }
        finally
        {
            cargando = false;
        }
    }

    private string NombreDocente(int cedula)
    {
        var docente = docentes.FirstOrDefault(x => x.Cedula == cedula);
        return docente is null
            ? cedula.ToString()
            : $"{docente.Nombres} {docente.Apellidos}";
    }

    private async Task Guardar()
    {
        guardando = true;
        try
        {
            var resultado = await Servicio.Guardar(
                formulario,
                editando,
                docenteOriginal,
                terminoClaveOriginal);
            mensaje = resultado.Mensaje;
            esError = !resultado.Ok;
            if (resultado.Ok)
            {
                Limpiar();
                intereses = await Servicio.Listar();
            }
        }
        catch (Exception ex) when (ex is HttpRequestException or JsonException)
        {
            Logger.LogError(ex, "No fue posible guardar el interés futuro.");
            MostrarError("No fue posible comunicarse con la API para guardar el interés.");
        }
        finally
        {
            guardando = false;
        }
    }

    private void Editar(InteresFuturoDto interes)
    {
        formulario = new InteresFuturoDto
        {
            Docente = interes.Docente,
            TerminoClave = interes.TerminoClave
        };
        docenteOriginal = interes.Docente;
        terminoClaveOriginal = interes.TerminoClave;
        editando = true;
        mensaje = string.Empty;
    }

    private async Task Eliminar(int docente, string terminoClave)
    {
        try
        {
            var resultado = await Servicio.Eliminar(docente, terminoClave);
            mensaje = resultado.Mensaje;
            esError = !resultado.Ok;
            if (resultado.Ok)
                intereses = await Servicio.Listar();
        }
        catch (Exception ex) when (ex is HttpRequestException or JsonException)
        {
            Logger.LogError(ex, "No fue posible retirar el interés futuro.");
            MostrarError("No fue posible comunicarse con la API para retirar el interés.");
        }
    }

    private void Limpiar()
    {
        formulario = new();
        editando = false;
        docenteOriginal = 0;
        terminoClaveOriginal = string.Empty;
    }

    private void MostrarError(string texto)
    {
        mensaje = texto;
        esError = true;
    }
}
