@page "/"

<PageTitle>Inicio</PageTitle>

<div class="inicio">
    <h1>Sistema de Gestión Profesoral</h1>

    <p>
        Plataforma para la administración de la información
        del sistema de Gestión Profesoral.
    </p>

    <div class="inicio-opciones">

        <div class="inicio-card">
            <h3>Programas</h3>

            <p>
                Consulta, registra y administra los programas académicos.
            </p>

            <a href="/programas" class="btn btn-primary">
                Gestionar programas
            </a>
        </div>

        <div class="inicio-card">
            <h3>Áreas de Conocimiento</h3>

            <p>
                Consulta, registra y administra las áreas de conocimiento.
            </p>

            <a href="/areas-conocimiento" class="btn btn-primary">
                Gestionar áreas
            </a>
        </div>

    </div>
</div>