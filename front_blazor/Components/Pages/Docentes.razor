    protected override async Task OnInitializedAsync()

    {

        try

        {

            lineas = await ServicioLineas.ObtenerTodosAsync();

            await Cargar();

        }

        catch (Exception)

        {

            error = true;

            mensaje = "No fue posible cargar la información.";

            cargando = false;

        }

    }

    private async Task Cargar()

    {

        cargando = true;

        try

        {

            docentes = await Servicio.Listar();

        }

        finally

        {

            cargando = false;

        }

    }

    private async Task Guardar()

    {

        if (formulario.Cedula <= 0 ||

            string.IsNullOrWhiteSpace(formulario.Nombres) ||

            string.IsNullOrWhiteSpace(formulario.Apellidos) ||

            string.IsNullOrWhiteSpace(formulario.Correo))

        {

            error = true;

            mensaje = "Complete la cédula, los nombres, apellidos y correo.";

            return;

        }

        guardando = true;

        try

        {

            var resultado = await Servicio.Guardar(

                formulario, editando);

            error = !resultado.Ok;

            mensaje = resultado.Mensaje;

            if (resultado.Ok)

            {

                var cedulaGuardada = formulario.Cedula;

                LimpiarFormulario();

                await Cargar();

                if (docenteSeleccionado?.Cedula == cedulaGuardada)

                {

                    docenteSeleccionado = docentes.FirstOrDefault(

                        d => d.Cedula == cedulaGuardada);

                    if (docenteSeleccionado is null)

                    {

                        CerrarDetalle();

                    }

                }

            }

        }

        catch (Exception)

        {

            error = true;

            mensaje = "No fue posible comunicarse con la API.";

        }

        finally

        {

            guardando = false;

        }

    }

    private void Editar(DocenteDto docente)

    {

        formulario = new DocenteDto

        {

            Cedula = docente.Cedula,

            Nombres = docente.Nombres,

            Apellidos = docente.Apellidos,

            Genero = docente.Genero,

            Cargo = docente.Cargo,

            FechaNacimiento = docente.FechaNacimiento,

            Correo = docente.Correo,

            Telefono = docente.Telefono,

            UrlCvlac = docente.UrlCvlac,

            Escalafon = docente.Escalafon,

            Perfil = docente.Perfil,

            CatMinciencia = docente.CatMinciencia,

            ConvMinciencia = docente.ConvMinciencia,

            Nacionalidaad = docente.Nacionalidaad,

            LineaInvestigacionPrincipal =

                docente.LineaInvestigacionPrincipal

        };

        editando = true;

        mensaje = "";

    }

    private async Task Eliminar(int cedula)

    {

        try

        {

            var resultado = await Servicio.Eliminar(cedula);

            error = !resultado.Ok;

            mensaje = resultado.Mensaje;

            if (resultado.Ok)

            {

                if (editando && formulario.Cedula == cedula)

                {

                    LimpiarFormulario();

                }

                if (docenteSeleccionado?.Cedula == cedula)

                {

                    CerrarDetalle();

                }

                await Cargar();

            }

        }

        catch (Exception)

        {

            error = true;

            mensaje = "No fue posible retirar el docente.";

        }

    }

    private void Limpiar()

    {

        LimpiarFormulario();

        mensaje = "";

