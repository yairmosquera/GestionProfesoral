@page "/docentes"

@rendermode InteractiveServer

@using FrontGestion.Servicios

@inject ServicioDocente Servicio

@inject ServicioLineaInvestigacion ServicioLineas

@inject ServicioEstudioRealizado ServicioEstudios

@inject ServicioEvaluacionDocente ServicioEvaluaciones

@inject ServicioExperienciaDocente ServicioExperiencias
@inject ServicioReconocimientoDocente ServicioReconocimientos
@inject ServicioRedDocente ServicioRedesDocentes
@inject ServicioDocenteDepartamento ServicioDepartamentos

<PageTitle>Docentes</PageTitle>

<h1>Gestión de Docentes</h1>

@if (!string.IsNullOrWhiteSpace(mensaje))

{

    <div class="alert @(error ? "alert-danger" : "alert-success")">

        @mensaje

    </div>

}

<!-- FORMULARIO DE DOCENTES -->

<div class="card mb-4">

    <div class="card-body">

        <h4>@(editando ? "Editar docente" : "Registrar docente")</h4>

        <div class="row g-3">

            <div class="col-md-4">

                <label class="form-label">Cédula</label>

                <input type="number" class="form-control" @bind="formulario.Cedula" disabled="@editando" />

            </div>

            <div class="col-md-4">

                <label class="form-label">Nombres</label>

                <input class="form-control" @bind="formulario.Nombres" />

            </div>

            <div class="col-md-4">

                <label class="form-label">Apellidos</label>

                <input class="form-control" @bind="formulario.Apellidos" />

            </div>

            <div class="col-md-4">

                <label class="form-label">Género</label>

                <select class="form-select" @bind="formulario.Genero">

                    <option value="">Seleccione</option>

                    <option value="Femenino">Femenino</option>

                    <option value="Masculino">Masculino</option>

                    <option value="Otro">Otro</option>

                </select>

            </div>

            <div class="col-md-4">

                <label class="form-label">Cargo</label>

                <input class="form-control" @bind="formulario.Cargo" />

            </div>

            <div class="col-md-4">

                <label class="form-label">Fecha de nacimiento</label>

                <input type="date" class="form-control" @bind="formulario.FechaNacimiento" @bind:format="yyyy-MM-dd" />

            </div>

            <div class="col-md-6">

                <label class="form-label">Correo electrónico</label>

                <input type="email" class="form-control" @bind="formulario.Correo" />

            </div>

            <div class="col-md-6">

                <label class="form-label">Teléfono</label>

                <input class="form-control" @bind="formulario.Telefono" />

            </div>

            <div class="col-md-6">

                <label class="form-label">URL CvLAC</label>

                <input class="form-control" @bind="formulario.UrlCvlac" />

            </div>

            <div class="col-md-6">

                <label class="form-label">Escalafón</label>

                <input class="form-control" @bind="formulario.Escalafon" />

            </div>

            <div class="col-md-6">

                <label class="form-label">Categoría Minciencias</label>

                <input class="form-control" @bind="formulario.CatMinciencia" />

            </div>

            <div class="col-md-6">

                <label class="form-label">Convocatoria Minciencias</label>

                <input class="form-control" @bind="formulario.ConvMinciencia" />

            </div>

            <div class="col-md-6">

                <label class="form-label">Nacionalidad</label>

                <input class="form-control" @bind="formulario.Nacionalidaad" />

            </div>

            <div class="col-md-6">

                <label class="form-label">

                    Línea de investigación principal

                </label>

                <select class="form-select" @bind="formulario.LineaInvestigacionPrincipal">

                    <option value="">(Ninguna)</option>

                    @foreach (var linea in lineas)

                    {

                        <option value="@linea.Id">

                            @linea.Nombre

                        </option>

                    }

                </select>

            </div>

            <div class="col-12">

                <label class="form-label">Perfil</label>

                <textarea class="form-control" rows="3" @bind="formulario.Perfil"></textarea>

            </div>

            <div class="col-12">

                <button class="btn btn-primary me-2" disabled="@guardando" @onclick="Guardar">

                    @(guardando

                        ? "Guardando..."

                        : editando ? "Actualizar" : "Guardar")

                </button>

                <button class="btn btn-secondary" disabled="@guardando" @onclick="Limpiar">

                    Limpiar

                </button>

            </div>

        </div>

    </div>

</div>

<!-- LISTADO DE DOCENTES -->

<h4 class="mb-3">Docentes registrados</h4>

@if (cargando)

{

    <p>Cargando docentes...</p>

}

else if (docentes.Count == 0)

{

    <div class="alert alert-info">

        No hay docentes registrados.

    </div>

}

else

{

    <div class="table-responsive">

        <table class="table table-striped table-bordered align-middle tabla-docentes">

            <thead class="table-light">

                <tr>

                    <th>Cédula</th>

                    <th>Nombres</th>

                    <th>Apellidos</th>

                    <th>Correo</th>

                    <th>Cargo</th>

                    <th class="columna-acciones">Acciones</th>

                </tr>

            </thead>

            <tbody>

                @foreach (var docente in docentes)

                {

                    <tr>

                        <td>@docente.Cedula</td>

                        <td>@docente.Nombres</td>

                        <td>@docente.Apellidos</td>

                        <td>@docente.Correo</td>

                        <td>@docente.Cargo</td>

                        <td class="columna-acciones">

                            <div class="acciones-docente">
                                <button type="button" class="btn btn-warning btn-accion" @onclick="() => Editar(docente)">✏️
                                    Editar</button>

                                    <details class="detalles-acciones">
                                        <summary class="btn btn-primary btn-accion">📂 Ver más ▾</summary>
                                        <div class="menu-acciones-docente">
                                            <button type="button" @onclick="() => VerEstudios(docente)">📚 Estudios
                                                realizados</button>
                                                <button type="button" @onclick="() => VerEvaluaciones(docente)">📋 Evaluaciones
                                                    docentes</button>
                                                    <button type="button" @onclick="() => VerExperiencias(docente)">💼 Experiencias
                                                        docentes</button>
                                                        <button type="button" @onclick="() => VerReconocimientos(docente)">🏆 Reconocimientos
                                                            docentes</button>
                                                            <button type="button" @onclick="() => VerRedes(docente)">🌐 Redes de
                                                                investigación</button>
                                                                <button type="button" @onclick="() => VerDepartamentos(docente)">🏛️ Departamentos /
                                                                    Programas</button>
                                                                </div>
                                                            </details>

                                                            <button type="button" class="btn btn-danger btn-accion btn-retirar"
                                                                    @onclick="() => Eliminar(docente.Cedula)">🗑️ Retirar</button>
                                                        </div>

                                                    </td>

                                                </tr>

                                            }

                                        </tbody>

                                    </table>

                                </div>

                            }

                            <!-- HISTORIAL DEL DOCENTE SELECCIONADO -->

                            @if (docenteSeleccionado is not null)

                            {

                                <div class="card mt-4 mb-4 border-primary">

                                    <div class="card-header bg-primary text-white">

                                        <div class="d-flex justify-content-between align-items-center gap-2">

                                            <h5 class="mb-0">

                                                @(tipoDetalle == "estudios"

                                                    ? "📚 Estudios realizados"

                                                    : tipoDetalle == "evaluaciones"

                                                        ? "📋 Evaluaciones docentes"

                                                        : tipoDetalle == "experiencias"
                                                            ? "💼 Experiencias docentes"
                                                            : tipoDetalle == "reconocimientos"
                                                                ? "🏆 Reconocimientos docentes"
                                                                : tipoDetalle == "redes"
                                                                    ? "🌐 Redes de investigación"
                                                                    : "🏛️ Departamentos / Programas")

                                            </h5>

                                            <button type="button" class="btn btn-sm btn-light" @onclick="CerrarDetalle">

                                                Cerrar

                                            </button>

                                        </div>

                                    </div>

                                    <div class="card-body">

                                        <div class="alert alert-light border">

                                            <strong>Docente:</strong>

                                            @docenteSeleccionado.Nombres

                                            @docenteSeleccionado.Apellidos

                                            <div>

                                                <strong>Cédula:</strong>

                                                @docenteSeleccionado.Cedula

                                            </div>

                                        </div>

                                        <!-- ESTUDIOS -->

                                        @if (tipoDetalle == "estudios")

                                        {

                                            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">

                                                <h5 class="mb-0">Historial académico</h5>

                                                <a class="btn btn-success" href="@($"/estudios-realizados?docente={docenteSeleccionado.Cedula}")">

                                                    + Registrar nuevo estudio

                                                </a>

                                            </div>

                                            @if (!string.IsNullOrWhiteSpace(mensajeDetalle))

                                            {

                                                <div class="alert alert-danger">

                                                    @mensajeDetalle

                                                </div>

                                            }

                                            @if (cargandoDetalle)

                                            {

                                                <p>Cargando estudios...</p>

                                            }

                                            else if (estudiosDocente.Count == 0)

                                            {

                                                <div class="alert alert-info">

                                                    Este docente todavía no tiene estudios registrados.

                                                </div>

                                            }

                                            else

                                            {

                                                <div class="table-responsive">

                                                    <table class="table table-striped table-bordered align-middle">

                                                        <thead class="table-light">

                                                            <tr>

                                                                <th>Código</th>

                                                                <th>Título obtenido</th>

                                                                <th>Universidad</th>

                                                                <th>Tipo</th>

                                                                <th>Fecha</th>

                                                                <th>País</th>

                                                            </tr>

                                                        </thead>

                                                        <tbody>

                                                            @foreach (var estudio in estudiosDocente)

                                                            {

                                                                <tr>

                                                                    <td>@estudio.Id</td>

                                                                    <td>@estudio.Titulo</td>

                                                                    <td>@estudio.Universidad</td>

                                                                    <td>@estudio.Tipo</td>

                                                                    <td>@estudio.Fecha.ToString("dd/MM/yyyy")</td>

                                                                    <td>@estudio.Pais</td>

                                                                </tr>

                                                            }

                                                        </tbody>

                                                    </table>

                                                </div>

                                                <p class="text-muted small">

                                                    Total de estudios:

                                                    <strong>@estudiosDocente.Count</strong>

                                                </p>

                                            }

                                        }

                                        <!-- EVALUACIONES -->

                                        @if (tipoDetalle == "evaluaciones")

                                        {

                                            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">

                                                <h5 class="mb-0">Historial de evaluaciones</h5>

                                                <a class="btn btn-success" href="@($"/evaluaciones-docentes?docente={docenteSeleccionado.Cedula}")">

                                                    + Registrar nueva evaluación

                                                </a>

                                            </div>

                                            @if (!string.IsNullOrWhiteSpace(mensajeDetalle))

                                            {

                                                <div class="alert alert-danger">

                                                    @mensajeDetalle

                                                </div>

                                            }

                                            @if (cargandoDetalle)

                                            {

                                                <p>Cargando evaluaciones...</p>

                                            }

                                            else if (evaluacionesDocente.Count == 0)

                                            {

                                                <div class="alert alert-info">

                                                    Este docente todavía no tiene evaluaciones registradas.

                                                </div>

                                            }

                                            else

                                            {

                                                <div class="table-responsive">

                                                    <table class="table table-striped table-bordered align-middle">

                                                        <thead class="table-light">

                                                            <tr>

                                                                <th>Código</th>

                                                                <th>Semestre</th>

                                                                <th>Calificación</th>

                                                            </tr>

                                                        </thead>

                                                        <tbody>

                                                            @foreach (var evaluacion in evaluacionesDocente)

                                                            {

                                                                <tr>

                                                                    <td>@evaluacion.Id</td>

                                                                    <td>@evaluacion.Semestre</td>

                                                                    <td>@evaluacion.Calificacion.ToString("0.##")</td>

                                                                </tr>

                                                            }

                                                        </tbody>

                                                    </table>

                                                </div>

                                                <p class="text-muted small">

                                                    Total de evaluaciones:

                                                    <strong>@evaluacionesDocente.Count</strong>

                                                </p>

                                            }

                                        }

                                        <!-- EXPERIENCIAS -->

                                        @if (tipoDetalle == "experiencias")

                                        {

                                            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">

                                                <h5 class="mb-0">Historial de experiencias</h5>

                                                <a class="btn btn-success" href="@($"/experiencias-docentes?docente={docenteSeleccionado.Cedula}")">

                                                    + Registrar nueva experiencia

                                                </a>

                                            </div>

                                            @if (!string.IsNullOrWhiteSpace(mensajeDetalle))

                                            {

                                                <div class="alert alert-danger">

                                                    @mensajeDetalle

                                                </div>

                                            }

                                            @if (cargandoDetalle)

                                            {

                                                <p>Cargando experiencias...</p>

                                            }

                                            else if (experienciasDocente.Count == 0)

                                            {

                                                <div class="alert alert-info">

                                                    Este docente todavía no tiene experiencias registradas.

                                                </div>

                                            }

                                            else

                                            {

                                                <div class="table-responsive">

                                                    <table class="table table-striped table-bordered align-middle">

                                                        <thead class="table-light">

                                                            <tr>

                                                                <th>Código</th>

                                                                <th>Cargo</th>

                                                                <th>Institución</th>

                                                                <th>Tipo</th>

                                                                <th>Fecha inicio</th>

                                                                <th>Fecha fin</th>

                                                            </tr>

                                                        </thead>

                                                        <tbody>

                                                            @foreach (var experiencia in experienciasDocente)

                                                            {

                                                                <tr>

                                                                    <td>@experiencia.Id</td>

                                                                    <td>@experiencia.NombreCargo</td>

                                                                    <td>@experiencia.Institucion</td>

                                                                    <td>@experiencia.Tipo</td>

                                                                    <td>@experiencia.FechaInicio.ToString("dd/MM/yyyy")</td>

                                                                    <td>

                                                                        @(experiencia.FechaFin.HasValue

                                                                            ? experiencia.FechaFin.Value.ToString("dd/MM/yyyy")

                                                                            : "Actualidad")

                                                                    </td>

                                                                </tr>

                                                            }

                                                        </tbody>

                                                    </table>

                                                </div>

                                                <p class="text-muted small">

                                                    Total de experiencias:

                                                    <strong>@experienciasDocente.Count</strong>

                                                </p>

                                            }

                                        }

                                        <!-- RECONOCIMIENTOS -->
                                        @if (tipoDetalle == "reconocimientos")
                                        {
                                            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
                                                <h5 class="mb-0">Historial de reconocimientos</h5>
                                                <a class="btn btn-success" href="@($"/reconocimientos-docentes?docente={docenteSeleccionado.Cedula}")">
                                                    + Registrar nuevo reconocimiento
                                                </a>
                                            </div>

                                            @if (!string.IsNullOrWhiteSpace(mensajeDetalle))
                                            {
                                                <div class="alert alert-danger">@mensajeDetalle</div>
                                            }

                                            @if (cargandoDetalle)
                                            {
                                                <p>Cargando reconocimientos...</p>
                                            }
                                            else if (reconocimientosDocente.Count == 0)
                                            {
                                                <div class="alert alert-info">Este docente todavía no tiene reconocimientos registrados.</div>
                                            }
                                            else
                                            {
                                                <div class="table-responsive">
                                                    <table class="table table-striped table-bordered align-middle">
                                                        <thead class="table-light">
                                                            <tr>
                                                                <th>Código</th>
                                                                <th>Nombre</th>
                                                                <th>Institución</th>
                                                                <th>Tipo</th>
                                                                <th>Ámbito</th>
                                                                <th>Fecha</th>
                                                            </tr>
                                                        </thead>
                                                        <tbody>
                                                            @foreach (var reconocimiento in reconocimientosDocente)
                                                            {
                                                                <tr>
                                                                    <td>@reconocimiento.Id</td>
                                                                    <td>@reconocimiento.Nombre</td>
                                                                    <td>@reconocimiento.Institucion</td>
                                                                    <td>@reconocimiento.Tipo</td>
                                                                    <td>@reconocimiento.Ambito</td>
                                                                    <td>@reconocimiento.Fecha.ToString("dd/MM/yyyy")</td>
                                                                </tr>
                                                            }
                                                        </tbody>
                                                    </table>
                                                </div>
                                                <p class="text-muted small">Total de reconocimientos: <strong>@reconocimientosDocente.Count</strong></p>
                                            }
                                        }

                                        <!-- REDES DEL DOCENTE -->
                                        @if (tipoDetalle == "redes")
                                        {
                                            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
                                                <h5 class="mb-0">Redes asociadas al docente</h5>
                                                <a class="btn btn-success" href="@($"/redes-docentes?docente={docenteSeleccionado.Cedula}")">
                                                    + Asociar nueva red
                                                </a>
                                            </div>

                                            @if (!string.IsNullOrWhiteSpace(mensajeDetalle))
                                            {
                                                <div class="alert alert-danger">@mensajeDetalle</div>
                                            }

                                            @if (cargandoDetalle)
                                            {
                                                <p>Cargando redes...</p>
                                            }
                                            else if (redesDocente.Count == 0)
                                            {
                                                <div class="alert alert-info">Este docente todavía no tiene redes asociadas.</div>
                                            }
                                            else
                                            {
                                                <div class="table-responsive">
                                                    <table class="table table-striped table-bordered align-middle">
                                                        <thead class="table-light">
                                                            <tr>
                                                                <th>ID de red</th>
                                                                <th>Fecha de inicio</th>
                                                                <th>Fecha de finalización</th>
                                                                <th>Actividades destacadas</th>
                                                            </tr>
                                                        </thead>
                                                        <tbody>
                                                            @foreach (var red in redesDocente)
                                                            {
                                                                <tr>
                                                                    <td>@red.Red</td>
                                                                    <td>@red.FechaInicio.ToString("dd/MM/yyyy")</td>
                                                                    <td>@(string.IsNullOrWhiteSpace(red.FechaFin) ? "Actualidad" : red.FechaFin)</td>
                                                                    <td>@red.ActDestacadas</td>
                                                                </tr>
                                                            }
                                                        </tbody>
                                                    </table>
                                                </div>
                                                <p class="text-muted small">Total de redes: <strong>@redesDocente.Count</strong></p>
                                            }
                                        }
                                        @if (tipoDetalle == "departamentos")
                                        {
                                            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
                                                <h5 class="mb-0">Departamentos / Programas vinculados</h5>
                                                <a class="btn btn-success" href="@($"/docentes-departamentos?docente={docenteSeleccionado.Cedula}")">
                                                    + Vincular nuevo departamento
                                                </a>
                                            </div>

                                            @if (!string.IsNullOrWhiteSpace(mensajeDetalle))
                                            {
                                                <div class="alert alert-danger">@mensajeDetalle</div>
                                            }

                                            @if (cargandoDetalle)
                                            {
                                                <p>Cargando departamentos...</p>
                                            }
                                            else if (departamentosDocente.Count == 0)
                                            {
                                                <div class="alert alert-info">
                                                    Este docente todavía no tiene departamentos o programas vinculados.
                                                </div>
                                            }
                                            else
                                            {
                                                <div class="table-responsive">
                                                    <table class="table table-striped table-bordered align-middle">
                                                        <thead class="table-light">
                                                            <tr>
                                                                <th>ID Programa</th>
                                                                <th>Dedicación</th>
                                                                <th>Modalidad</th>
                                                                <th>Fecha ingreso</th>
                                                                <th>Fecha salida</th>
                                                            </tr>
                                                        </thead>
                                                        <tbody>
                                                            @foreach (var departamento in departamentosDocente)
                                                            {
                                                                <tr>
                                                                    <td>@departamento.Departamento</td>
                                                                    <td>@departamento.Dedicacion</td>
                                                                    <td>@departamento.Modalidad</td>
                                                                    <td>@departamento.FechaIngreso.ToString("dd/MM/yyyy")</td>
                                                                    <td>@(departamento.FechaSalida.HasValue
                                                                                                                    ? departamento.FechaSalida.Value.ToString("dd/MM/yyyy")
                                                                                                                : "Actualidad")</td>
                                                                    </tr>
                                                                }
                                                            </tbody>
                                                        </table>
                                                    </div>
                                                    <p class="text-muted small">
                                                        Total de vinculaciones: <strong>@departamentosDocente.Count</strong>
                                                    </p>
                                                }
                                            }
                                        </div>

                                    </div>

                                }

                                <style>
                                    .tabla-docentes {

                                        width: 100%;

                                    }

                                    .tabla-docentes td {

                                        vertical-align: middle;

                                    }

                                    .tabla-docentes .columna-acciones {

                                        width: 290px;

                                        min-width: 290px;

                                    }

                                    .acciones-docente {

                                        display: grid;

                                        grid-template-columns: repeat(2, minmax(0, 1fr));

                                        gap: 8px;

                                        width: 100%;

                                    }

                                    .acciones-docente .btn-accion {

                                        display: flex;

                                        align-items: center;

                                        justify-content: center;

                                        width: 100%;

                                        min-height: 38px;

                                        padding: 7px 8px;

                                        border-radius: 6px;

                                        font-size: 12px;

                                        font-weight: 600;

                                        white-space: nowrap;

                                        transition: background-color 0.2s ease,

                                            transform 0.2s ease;

                                    }

                                    .acciones-docente .btn-warning {

                                        background-color: #f59e0b;

                                        border-color: #f59e0b;

                                        color: #ffffff;

                                    }

                                    .acciones-docente .btn-warning:hover {

                                        background-color: #d97706;

                                        border-color: #d97706;

                                        color: #ffffff;

                                    }

                                    .acciones-docente .btn-primary {

                                        background-color: #2563eb;

                                        border-color: #2563eb;

                                        color: #ffffff;

                                    }

                                    .acciones-docente .btn-primary:hover {

                                        background-color: #1d4ed8;

                                        border-color: #1d4ed8;

                                        color: #ffffff;

                                    }

                                    .acciones-docente .btn-evaluaciones {

                                        background-color: #0d9488;

                                        border-color: #0d9488;

                                        color: #ffffff;

                                    }

                                    .acciones-docente .btn-evaluaciones:hover {

                                        background-color: #0f766e;

                                        border-color: #0f766e;

                                        color: #ffffff;

                                    }

                                    .acciones-docente .btn-experiencias {

                                        background-color: #7c3aed;

                                        border-color: #7c3aed;

                                        color: #ffffff;

                                    }

                                    .acciones-docente .btn-experiencias:hover {

                                        background-color: #6d28d9;

                                        border-color: #6d28d9;

                                        color: #ffffff;

                                    }

                                    .acciones-docente .btn-danger {

                                        background-color: #dc2626;

                                        border-color: #dc2626;

                                        color: #ffffff;

                                    }

                                    .acciones-docente .btn-danger:hover {

                                        background-color: #b91c1c;

                                        border-color: #b91c1c;

                                        color: #ffffff;

                                    }

