@page "/docentes-departamentos"
@rendermode InteractiveServer

@using FrontGestion.Servicios
@using Microsoft.AspNetCore.Components
@using System.Net.Http.Json

@inject ServicioDocenteDepartamento Servicio
@inject ServicioDocente ServicioDocentes
@inject HttpClient Http

<PageTitle>Docentes - Departamentos</PageTitle>

<h1>Gestión de Docentes por Departamento</h1>

<p class="text-muted">
    Administra las vinculaciones de docentes con
    programas o departamentos académicos.
</p>

@if (!string.IsNullOrWhiteSpace(mensaje))
{
    <div class="alert @(esError ? "alert-danger" : "alert-success")">
        @mensaje
    </div>
}

<div class="card mb-4">
    <div class="card-body">

        <h4 class="mb-4">
            @(editando ? "Editar vinculación" : "Registrar vinculación")
        </h4>

        <div class="departamento-form-grid">

            <!-- FILA 1 -->

            <div class="campo-departamento span-6">
                <label class="form-label">Docente</label>

                <select class="form-select" @bind="formulario.Docente" disabled="@editando">
                    <option value="0">Seleccione un docente</option>

                    @foreach (var docente in docentes)
                    {
                        <option value="@docente.Cedula">
                            @docente.Nombres @docente.Apellidos - @docente.Cedula
                        </option>
                    }
                </select>
            </div>

            <div class="campo-departamento span-6">
                <label class="form-label">Departamento / Programa</label>

                <select class="form-select" @bind="formulario.Departamento" disabled="@editando">
                    <option value="0">Seleccione un programa</option>

                    @foreach (var programa in programas)
                    {
                        <option value="@programa.Id">
                            @programa.Nombre
                        </option>
                    }
                </select>
            </div>

            <!-- FILA 2 -->

            <div class="campo-departamento span-6">
                <label class="form-label">Dedicación</label>

                <select class="form-select" @bind="formulario.Dedicacion">
                    <option value="">Seleccione</option>
                    <option value="Tiempo completo">Tiempo completo</option>
                    <option value="Medio tiempo">Medio tiempo</option>
                    <option value="Catedrático">Catedrático</option>
                    <option value="Parcial">Parcial</option>
                    <option value="Otra">Otra</option>
                </select>
            </div>

            <div class="campo-departamento span-6">
                <label class="form-label">Modalidad</label>

                <select class="form-select" @bind="formulario.Modalidad">
                    <option value="">Seleccione</option>
                    <option value="Presencial">Presencial</option>
                    <option value="Virtual">Virtual</option>
                    <option value="Híbrida">Híbrida</option>
                    <option value="Distancia">Distancia</option>
                    <option value="Otra">Otra</option>
                </select>
            </div>

            <!-- FILA 3 -->

            <div class="campo-departamento span-6">
                <label class="form-label">Fecha de ingreso</label>

                <input type="date" class="form-control" @bind="formulario.FechaIngreso" @bind:format="yyyy-MM-dd" />
            </div>

            <div class="campo-departamento span-6">
                <label class="form-label">Fecha de salida</label>

                <input type="date" class="form-control" @bind="formulario.FechaSalida" @bind:format="yyyy-MM-dd" />

                <div class="form-text">
                    Opcional. Déjala vacía si continúa vinculado.
                </div>
            </div>

        </div>

        <!-- BOTONES ORIGINALES DEL FORMULARIO -->

        <div class="botones-formulario-departamento">

            <button class="btn btn-primary me-2" disabled="@guardando" @onclick="Guardar">
                @(guardando
                    ? "Guardando..."
                    : editando ? "Actualizar" : "Guardar")
            </button>

            <button class="btn btn-secondary" disabled="@guardando" @onclick="Limpiar">
                Limpiar
            </button>

        </div>

    </div>
</div>

<!-- LISTADO -->

<h4 class="mb-3">Vinculaciones registradas</h4>

@if (cargando)
{
    <p>Cargando vinculaciones...</p>
}
else if (relaciones.Count == 0)
{
    <div class="alert alert-info">
        No hay docentes vinculados a departamentos.
    </div>
}
else
{
    <div class="table-responsive">

        <table class="table table-striped table-bordered align-middle">

            <thead class="table-light">
                <tr>
                    <th>Docente</th>
                    <th>Departamento / Programa</th>
                    <th>Dedicación</th>
                    <th>Modalidad</th>
                    <th>Fecha ingreso</th>
                    <th>Fecha salida</th>
                    <th class="columna-acciones-departamento">Acciones</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var relacion in relaciones)
                {
                    <tr>
                        <td>@NombreDocente(relacion.Docente)</td>
                        <td>@NombrePrograma(relacion.Departamento)</td>
                        <td>@relacion.Dedicacion</td>
                        <td>@relacion.Modalidad</td>

                        <td>
                            @relacion.FechaIngreso.ToString("dd/MM/yyyy")
                        </td>

                        <td>
                            @(relacion.FechaSalida.HasValue
                                ? relacion.FechaSalida.Value.ToString("dd/MM/yyyy")
                                : "Actualidad")
                        </td>

                        <td class="columna-acciones-departamento">
                            <div class="acciones-departamento">

                                <button type="button" class="btn btn-warning btn-accion" @onclick="() => Editar(relacion)">
                                    ✏️ Editar
                                </button>

                                <button type="button" class="btn btn-danger btn-accion"
                                        @onclick="() => Eliminar(relacion.Docente, relacion.Departamento)">
                                    🗑️ Retirar
                                </button>

                            </div>
                        </td>
                    </tr>
                }
            </tbody>

        </table>

    </div>
}

<style>
    .departamento-form-grid {
        display: grid;
        grid-template-columns: repeat(12, minmax(0, 1fr));
        column-gap: 20px;
        row-gap: 20px;
        width: 100%;
    }

    .departamento-form-grid .span-6 {
        grid-column: span 6;
    }

    .departamento-form-grid .campo-departamento {
        min-width: 0;
    }

    .departamento-form-grid .form-label {
        display: block;
        margin-bottom: 7px;
        font-size: 13px;
        font-weight: 600;
    }

    .departamento-form-grid .form-control,
    .departamento-form-grid .form-select {
        display: block;
        width: 100%;
        max-width: 100%;
        min-width: 0;
        height: 40px;
        padding: 8px 12px;
        font-size: 14px;
        border: 1px solid #cbd5e1;
        border-radius: 6px;
        background-color: #ffffff;
        color: #1e293b;
        box-sizing: border-box;
    }

    .departamento-form-grid .form-control:focus,
    .departamento-form-grid .form-select:focus {
        border-color: #2563eb;
        outline: none;
        box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.12);
    }

    .departamento-form-grid .form-control:disabled,
    .departamento-form-grid .form-select:disabled {
        background-color: #e5e7eb;
        color: #64748b;
    }

    .departamento-form-grid .form-text {
        margin-top: 7px;
        font-size: 12px;
        color: #64748b;
    }

    .botones-formulario-departamento {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        margin-top: 24px;
    }

    .columna-acciones-departamento {
        width: 240px;
        min-width: 240px;
        vertical-align: middle;
    }

    .acciones-departamento {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 8px;
        width: 100%;
    }

    .acciones-departamento .btn-accion {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 100%;
        min-height: 38px;
        padding: 7px 8px;
        border-radius: 6px;
        font-size: 12px;
        font-weight: 600;
        white-space: nowrap;
        transition: background-color 0.2s ease,
            transform 0.2s ease;
    }

    .acciones-departamento .btn-warning {
        background-color: #f59e0b;
        border-color: #f59e0b;
        color: #ffffff;
    }

    .acciones-departamento .btn-warning:hover {
        background-color: #d97706;
        border-color: #d97706;
        color: #ffffff;
    }

    .acciones-departamento .btn-danger {
        background-color: #dc2626;
        border-color: #dc2626;
        color: #ffffff;
    }

    .acciones-departamento .btn-danger:hover {
        background-color: #b91c1c;
        border-color: #b91c1c;
        color: #ffffff;
    }

    .acciones-departamento .btn-accion:hover {
        transform: translateY(-1px);
    }

    @@media (max-width: 600px) {
        .departamento-form-grid .span-6 {
            grid-column: span 12;
        }

        .columna-acciones-departamento {
            width: 220px;
            min-width: 220px;
        }

        .acciones-departamento {
            gap: 6px;
        }
    }
</style>

@code {
    [SupplyParameterFromQuery(Name = "docente")]
    public int? DocenteDesdeUrl { get; set; }

    private sealed class ProgramaCatalogoDto
    {
        public int Id { get; set; }
        public string Nombre { get; set; } = string.Empty;
        public bool Activo { get; set; } = true;
    }

    private List<DocenteDepartamentoDto> relaciones = new();
    private List<DocenteDto> docentes = new();
    private List<ProgramaCatalogoDto> programas = new();

    private DocenteDepartamentoDto formulario = new();

    private bool cargando = true;
    private bool guardando;
    private bool editando;
    private bool esError;

    private string mensaje = "";

    protected override async Task OnInitializedAsync()
    {
        await Cargar();
        SeleccionarDocenteDesdeUrl();
    }

    private async Task Cargar()
    {
        cargando = true;

        try
        {
            docentes = await ServicioDocentes.Listar();

            var catalogo = await Http.GetFromJsonAsync<
                List<ProgramaCatalogoDto>>("api/programas");

            programas = catalogo?
                .Where(p => p.Activo)
                .ToList() ?? new();

            relaciones = await Servicio.Listar();
        }
        catch (Exception ex)
        {
            esError = true;
            mensaje = $"No fue posible cargar la información: {ex.Message}";
        }
        finally
        {
            cargando = false;
        }
    }

    private string NombreDocente(int cedula)
    {
        var docente = docentes.FirstOrDefault(
            d => d.Cedula == cedula);

        return docente is null
            ? $"Cédula: {cedula}"
            : $"{docente.Nombres} {docente.Apellidos}";
    }

    private string NombrePrograma(int id)
    {
        var programa = programas.FirstOrDefault(p => p.Id == id);

        return programa is null
            ? $"Programa {id}"
            : programa.Nombre;
    }

    private async Task Guardar()
    {
        if (guardando)
            return;

        if (formulario.Docente <= 0 ||
            formulario.Departamento <= 0 ||
            string.IsNullOrWhiteSpace(formulario.Dedicacion) ||
            string.IsNullOrWhiteSpace(formulario.Modalidad) ||
            formulario.FechaIngreso == default)
        {
            esError = true;
            mensaje = "Complete todos los campos obligatorios.";
            return;
        }

        if (formulario.FechaSalida.HasValue &&
            formulario.FechaSalida.Value.Date < formulario.FechaIngreso.Date)
        {
            esError = true;
            mensaje = "La fecha de salida no puede ser anterior a la de ingreso.";
            return;
        }

        guardando = true;

        try
        {
            var resultado = await Servicio.Guardar(
                formulario, editando);

            esError = !resultado.Ok;
            mensaje = resultado.Mensaje;

            if (resultado.Ok)
            {
                LimpiarFormulario();
                await Cargar();
            }
        }
        catch (Exception)
        {
            esError = true;
            mensaje = "No fue posible comunicarse con la API.";
        }
        finally
        {
            guardando = false;
        }
    }

    private void Editar(DocenteDepartamentoDto relacion)
    {
        formulario = new DocenteDepartamentoDto
        {
            Docente = relacion.Docente,
            Departamento = relacion.Departamento,
            Dedicacion = relacion.Dedicacion,
            Modalidad = relacion.Modalidad,
            FechaIngreso = relacion.FechaIngreso,
            FechaSalida = relacion.FechaSalida,
            Activo = relacion.Activo
        };

        editando = true;
        mensaje = "";
    }

    private async Task Eliminar(int docente, int departamento)
    {
        try
        {
            var resultado = await Servicio.Eliminar(
                docente, departamento);

            esError = !resultado.Ok;
            mensaje = resultado.Mensaje;

            if (resultado.Ok)
            {
                if (editando &&
                    formulario.Docente == docente &&
                    formulario.Departamento == departamento)
                {
                    LimpiarFormulario();
                }

                await Cargar();
            }
        }
        catch (Exception)
        {
            esError = true;
            mensaje = "No fue posible retirar la asociación.";
        }
    }

    private void Limpiar()
    {
        LimpiarFormulario();
        mensaje = "";
    }

    private void LimpiarFormulario()
    {
        formulario = new DocenteDepartamentoDto();
        editando = false;
        SeleccionarDocenteDesdeUrl();
    }

    private void SeleccionarDocenteDesdeUrl()
    {
        if (DocenteDesdeUrl.HasValue &&
            docentes.Any(d => d.Cedula == DocenteDesdeUrl.Value))
        {
            formulario.Docente = DocenteDesdeUrl.Value;
        }
    }
}
