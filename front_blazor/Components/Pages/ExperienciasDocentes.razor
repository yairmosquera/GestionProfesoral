@page "/experiencias-docentes"
@rendermode InteractiveServer

@using FrontGestion.Servicios
@using Microsoft.AspNetCore.Components

@inject ServicioExperienciaDocente Servicio
@inject ServicioDocente ServicioDocentes

<PageTitle>Experiencias Docentes</PageTitle>

<h1>Gestión de Experiencias Docentes</h1>

<p class="text-muted">
    Registra y administra la experiencia profesional
    y académica de los docentes.
</p>

@if (!string.IsNullOrWhiteSpace(mensaje))
{
    <div class="alert @(esError ? "alert-danger" : "alert-success")">
        @mensaje
    </div>
}

<div class="card mb-4">
    <div class="card-body">

        <h4 class="mb-4">
            @(editando ? "Editar experiencia" : "Registrar experiencia")
        </h4>

        <div class="experiencia-form-grid">

            <!-- FILA 1: CÓDIGO Y DOCENTE -->

            <div class="campo-experiencia span-3">
                <label class="form-label">Código de experiencia</label>

                <input class="form-control" value="@(editando ? formulario.Id.ToString() : "Automático")" disabled />
            </div>

            <div class="campo-experiencia span-9">
                <label class="form-label">Docente</label>

                <select class="form-select" @bind="formulario.Docente">
                    <option value="0">Seleccione un docente</option>

                    @foreach (var docente in docentes)
                    {
                        <option value="@docente.Cedula">
                            @docente.Nombres @docente.Apellidos - @docente.Cedula
                        </option>
                    }
                </select>
            </div>

            <!-- FILA 2: CARGO E INSTITUCIÓN -->

            <div class="campo-experiencia span-6">
                <label class="form-label">Nombre del cargo</label>

                <input class="form-control" maxlength="45" placeholder="Ejemplo: Docente universitario"
                       @bind="formulario.NombreCargo" />
            </div>

            <div class="campo-experiencia span-6">
                <label class="form-label">Institución</label>

                <input class="form-control" maxlength="45" placeholder="Nombre de la institución"
                       @bind="formulario.Institucion" />
            </div>

            <!-- FILA 3: TIPO Y FECHAS -->

            <div class="campo-experiencia span-4">
                <label class="form-label">Tipo de experiencia</label>

                <input class="form-control" maxlength="45" placeholder="Ejemplo: Docencia" @bind="formulario.Tipo" />
            </div>

            <div class="campo-experiencia span-4">
                <label class="form-label">Fecha de inicio</label>

                <input type="date" class="form-control" @bind="formulario.FechaInicio" @bind:format="yyyy-MM-dd" />
            </div>

            <div class="campo-experiencia span-4">
                <label class="form-label">Fecha de finalización</label>

                <input type="date" class="form-control" @bind="formulario.FechaFin" @bind:format="yyyy-MM-dd" />

                <div class="form-text">
                    Opcional. Déjala vacía si la experiencia continúa.
                </div>
            </div>

        </div>

        <!-- BOTONES DEL FORMULARIO -->

        <div class="botones-formulario-experiencia">

            <button class="btn btn-primary me-2" disabled="@guardando" @onclick="Guardar">
                @(guardando
                    ? "Guardando..."
                    : editando ? "Actualizar" : "Guardar")
            </button>

            <button class="btn btn-secondary" disabled="@guardando" @onclick="Limpiar">
                Limpiar
            </button>

        </div>

    </div>
</div>

<!-- LISTADO -->

<h4 class="mb-3">Experiencias registradas</h4>

@if (cargando)
{
    <p>Cargando experiencias...</p>
}
else if (experiencias.Count == 0)
{
    <div class="alert alert-info">
        No hay experiencias registradas.
    </div>
}
else
{
    <div class="table-responsive">

        <table class="table table-striped table-bordered align-middle">

            <thead class="table-light">
                <tr>
                    <th>ID</th>
                    <th>Docente</th>
                    <th>Cargo</th>
                    <th>Institución</th>
                    <th>Tipo</th>
                    <th>Fecha inicio</th>
                    <th>Fecha fin</th>
                    <th class="columna-acciones-experiencia">Acciones</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var experiencia in experiencias)
                {
                    <tr>
                        <td>@experiencia.Id</td>
                        <td>@NombreDocente(experiencia.Docente)</td>
                        <td>@experiencia.NombreCargo</td>
                        <td>@experiencia.Institucion</td>
                        <td>@experiencia.Tipo</td>

                        <td>
                            @experiencia.FechaInicio.ToString("dd/MM/yyyy")
                        </td>

                        <td>
                            @(experiencia.FechaFin.HasValue
                                ? experiencia.FechaFin.Value.ToString("dd/MM/yyyy")
                                : "Actualidad")
                        </td>

                        <td class="columna-acciones-experiencia">
                            <div class="acciones-experiencia">

                                <button type="button" class="btn btn-warning btn-accion" title="Editar experiencia"
                                        @onclick="() => Editar(experiencia)">
                                    ✏️ Editar
                                </button>

                                <button type="button" class="btn btn-danger btn-accion" title="Retirar experiencia"
                                        @onclick="() => Eliminar(experiencia.Id)">
                                    🗑️ Retirar
                                </button>

                            </div>
                        </td>
                    </tr>
                }
            </tbody>

        </table>
    </div>
}

<style>
    .experiencia-form-grid {
        display: grid;
        grid-template-columns: repeat(12, minmax(0, 1fr));
        column-gap: 20px;
        row-gap: 20px;
        width: 100%;
    }

    .experiencia-form-grid .span-3 {
        grid-column: span 3;
    }

    .experiencia-form-grid .span-4 {
        grid-column: span 4;
    }

    .experiencia-form-grid .span-6 {
        grid-column: span 6;
    }

    .experiencia-form-grid .span-9 {
        grid-column: span 9;
    }

    .experiencia-form-grid .campo-experiencia {
        min-width: 0;
    }

    .experiencia-form-grid .form-label {
        display: block;
        margin-bottom: 7px;
        font-size: 13px;
        font-weight: 600;
    }

    .experiencia-form-grid .form-control,
    .experiencia-form-grid .form-select {
        display: block;
        width: 100%;
        max-width: 100%;
        min-width: 0;
        height: 40px;
        padding: 8px 12px;
        font-size: 14px;
        border: 1px solid #cbd5e1;
        border-radius: 6px;
        background-color: #ffffff;
        color: #1e293b;
        box-sizing: border-box;
    }

    .experiencia-form-grid .form-control:focus,
    .experiencia-form-grid .form-select:focus {
        border-color: #2563eb;
        outline: none;
        box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.12);
    }

    .experiencia-form-grid .form-control:disabled {
        background-color: #e5e7eb;
        color: #64748b;
    }

    .experiencia-form-grid .form-text {
        margin-top: 7px;
        font-size: 12px;
        color: #64748b;
    }

    .botones-formulario-experiencia {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        margin-top: 24px;
    }

    .columna-acciones-experiencia {
        width: 240px;
        min-width: 240px;
        vertical-align: middle;
    }

    .acciones-experiencia {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 8px;
        width: 100%;
    }

    .acciones-experiencia .btn-accion {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 100%;
        min-height: 38px;
        padding: 7px 8px;
        border-radius: 6px;
        font-size: 12px;
        font-weight: 600;
        white-space: nowrap;
        transition: background-color 0.2s ease,
            transform 0.2s ease;
    }

    .acciones-experiencia .btn-warning {
        background-color: #f59e0b;
        border-color: #f59e0b;
        color: #ffffff;
    }

    .acciones-experiencia .btn-warning:hover {
        background-color: #d97706;
        border-color: #d97706;
        color: #ffffff;
    }

    .acciones-experiencia .btn-danger {
        background-color: #dc2626;
        border-color: #dc2626;
        color: #ffffff;
    }

    .acciones-experiencia .btn-danger:hover {
        background-color: #b91c1c;
        border-color: #b91c1c;
        color: #ffffff;
    }

    .acciones-experiencia .btn-accion:hover {
        transform: translateY(-1px);
    }

    @@media (max-width: 900px) {

        .experiencia-form-grid .span-3,
        .experiencia-form-grid .span-4,
        .experiencia-form-grid .span-6 {
            grid-column: span 6;
        }

        .experiencia-form-grid .span-9 {
            grid-column: span 12;
        }
    }

    @@media (max-width: 600px) {

        .experiencia-form-grid .span-3,
        .experiencia-form-grid .span-4,
        .experiencia-form-grid .span-6,
        .experiencia-form-grid .span-9 {
            grid-column: span 12;
        }

        .columna-acciones-experiencia {
            width: 220px;
            min-width: 220px;
        }

        .acciones-experiencia {
            gap: 6px;
        }

        .acciones-experiencia .btn-accion {
            font-size: 11px;
            padding: 7px 5px;
        }
    }
</style>

@code {
    [SupplyParameterFromQuery(Name = "docente")]
    public int? DocenteDesdeUrl { get; set; }

    private List<ExperienciaDocenteDto> experiencias = new();
    private List<DocenteDto> docentes = new();

    private ExperienciaDocenteDto formulario = new();

    private bool cargando = true;
    private bool guardando;
    private bool editando;
    private bool esError;

    private string mensaje = "";

    protected override async Task OnInitializedAsync()
    {
        await Cargar();

        SeleccionarDocenteDesdeUrl();
    }

    private async Task Cargar()
    {
        cargando = true;

        try
        {
            docentes = await ServicioDocentes.Listar();
            experiencias = await Servicio.Listar();
        }
        catch (Exception)
        {
            esError = true;
            mensaje = "No fue posible cargar las experiencias.";
        }
        finally
        {
            cargando = false;
        }
    }

    private string NombreDocente(int cedula)
    {
        var docente = docentes.FirstOrDefault(
            d => d.Cedula == cedula);

        return docente is null
            ? $"Cédula: {cedula}"
            : $"{docente.Nombres} {docente.Apellidos}";
    }

    private async Task Guardar()
    {
        if (guardando)
            return;

        if (formulario.Docente <= 0 ||
            string.IsNullOrWhiteSpace(formulario.NombreCargo) ||
            string.IsNullOrWhiteSpace(formulario.Institucion) ||
            string.IsNullOrWhiteSpace(formulario.Tipo) ||
            formulario.FechaInicio == default)
        {
            esError = true;
            mensaje = "Complete todos los campos obligatorios.";
            return;
        }

        if (formulario.FechaFin.HasValue &&
            formulario.FechaFin.Value.Date < formulario.FechaInicio.Date)
        {
            esError = true;
            mensaje = "La fecha final no puede ser anterior a la inicial.";
            return;
        }

        guardando = true;

        try
        {
            var resultado = await Servicio.Guardar(
                formulario, editando);

            esError = !resultado.Ok;
            mensaje = resultado.Mensaje;

            if (resultado.Ok)
            {
                LimpiarFormulario();
                await Cargar();
            }
        }
        catch (Exception)
        {
            esError = true;
            mensaje = "No fue posible comunicarse con la API.";
        }
        finally
        {
            guardando = false;
        }
    }

    private void Editar(ExperienciaDocenteDto experiencia)
    {
        formulario = new ExperienciaDocenteDto
        {
            Id = experiencia.Id,
            NombreCargo = experiencia.NombreCargo,
            Institucion = experiencia.Institucion,
            Tipo = experiencia.Tipo,
            FechaInicio = experiencia.FechaInicio,
            FechaFin = experiencia.FechaFin,
            Docente = experiencia.Docente,
            Activo = experiencia.Activo
        };

        editando = true;
        mensaje = "";
    }

    private async Task Eliminar(int id)
    {
        try
        {
            var resultado = await Servicio.Eliminar(id);

            esError = !resultado.Ok;
            mensaje = resultado.Mensaje;

            if (resultado.Ok)
            {
                if (editando && formulario.Id == id)
                {
                    LimpiarFormulario();
                }

                await Cargar();
            }
        }
        catch (Exception)
        {
            esError = true;
            mensaje = "No fue posible retirar la experiencia.";
        }
    }

    private void Limpiar()
    {
        LimpiarFormulario();
        mensaje = "";
    }

    private void LimpiarFormulario()
    {
        formulario = new ExperienciaDocenteDto();
        editando = false;

        SeleccionarDocenteDesdeUrl();
    }

    private void SeleccionarDocenteDesdeUrl()
    {
        if (DocenteDesdeUrl.HasValue &&
            docentes.Any(d => d.Cedula == DocenteDesdeUrl.Value))
        {
            formulario.Docente = DocenteDesdeUrl.Value;
        }
    }
}
