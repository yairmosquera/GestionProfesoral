@page "/docentes-maestro"
@rendermode InteractiveServer
@using FrontGestion.Servicios
@using System.ComponentModel.DataAnnotations
@inject ServicioDocenteMaestro ServicioMaestro
@inject ServicioDocente ServicioDocentes
@inject ServicioDocenteMaestroEdicion ServicioEdicion
@inject ServicioEstudioRealizado ServicioEstudios
@inject ServicioEvaluacionDocente ServicioEvaluaciones
@inject ServicioExperienciaDocente ServicioExperiencias
@inject ServicioReconocimientoDocente ServicioReconocimientos
@inject ServicioLineaInvestigacion ServicioLineas
@inject ServicioSesionJwt Sesion
<PageTitle>Docentes - Gestión Profesoral</PageTitle>
<div class="maestro-contenedor">
    <div class="maestro-encabezado">
        <div>
            <h1>@(editando ? "Editar docente" : "Registro Maestro de Docentes")</h1>
            <p class="text-muted mb-0">
                Registre la información personal, académica
                y profesional del docente.
            </p>
        </div>
        <span class="badge bg-primary">Versión 3 · @((Sesion.Autenticado ? Sesion.NombreUsuario : "Sin sesión"))</span>
    </div>
    @if (!string.IsNullOrWhiteSpace(mensaje))
    {
        <div class="alert @(esError ? "alert-danger" : "alert-success") mt-3" role="alert">
            @mensaje
        </div>
    }
    @if (editando)
    {
        <div class="alert alert-info">
            Editando al docente <strong>@formulario.Docente.Cedula</strong>.
            Puede actualizar datos personales, estudios, evaluaciones,
            experiencias y reconocimientos. Los cambios se guardan juntos
            al pulsar <strong>Actualizar docente y detalles</strong>.
        </div>
    }
    @if (cargandoDetallesEdicion)
    {
        <div class="alert alert-secondary">Cargando datos académicos del docente...</div>
    }

    @if (!Sesion.Autenticado)
    {
        <div class="alert alert-warning" role="alert">
            Debes iniciar sesión para consultar docentes.
            <a href="/login" class="alert-link">Ir al inicio de sesión</a>
        </div>
    }
    else if (!PuedeModificar)
    {
        <div class="alert alert-info" role="status">
            Tu cuenta tiene permisos de consulta. Puedes buscar y revisar el listado,
            pero no registrar, editar ni retirar docentes.
        </div>
    }
    @if (PuedeModificar)
    {
    <!-- NAVEGACIÓN POR PESTAÑAS -->
    <div class="maestro-navegacion">
        <button type="button" class="pestana @(pestana == "datos" ? "activa" : "")" disabled="@guardando"
                @onclick='() => CambiarPestana("datos")'>
            👤 Datos personales
        </button>
        <button type="button" class="pestana @(pestana == "estudios" ? "activa" : "")"
                @onclick='() => CambiarPestana("estudios")'
                disabled="@(guardando || cargandoDetallesEdicion)">
            🎓 Estudios
            <span class="contador">@formulario.Estudios.Count</span>
        </button>
        <button type="button" class="pestana @(pestana == "evaluaciones" ? "activa" : "")"
                @onclick='() => CambiarPestana("evaluaciones")'
                disabled="@(guardando || cargandoDetallesEdicion)">
            📋 Evaluaciones
            <span class="contador">@formulario.Evaluaciones.Count</span>
        </button>
        <button type="button" class="pestana @(pestana == "experiencias" ? "activa" : "")"
                @onclick='() => CambiarPestana("experiencias")'
                disabled="@(guardando || cargandoDetallesEdicion)">
            💼 Experiencia
            <span class="contador">@formulario.Experiencias.Count</span>
        </button>
        <button type="button" class="pestana @(pestana == "reconocimientos" ? "activa" : "")"
                @onclick='() => CambiarPestana("reconocimientos")'
                disabled="@(guardando || cargandoDetallesEdicion)">
            🏆 Reconocimientos
            <span class="contador">@formulario.Reconocimientos.Count</span>
        </button>
    </div>
    <!-- PESTAÑA 1: DATOS PERSONALES -->
    @if (pestana == "datos")
    {
        <div class="card maestro-card">
            <div class="card-header">
                <h4>1. Información del docente</h4>
                <small>Complete los datos personales y profesionales.</small>
            </div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-4">
                        <label class="form-label">Cédula *</label>
                        <input type="number" class="form-control" @bind="formulario.Docente.Cedula" disabled="@editando" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Nombres *</label>
                        <input class="form-control" maxlength="60" @bind="formulario.Docente.Nombres" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Apellidos *</label>
                        <input class="form-control" maxlength="60" @bind="formulario.Docente.Apellidos" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Género *</label>
                        <select class="form-select" @bind="formulario.Docente.Genero">
                            <option value="">Seleccione</option>
                            <option value="Femenino">Femenino</option>
                            <option value="Masculino">Masculino</option>
                            <option value="Otro">Otro</option>
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Cargo *</label>
                        <input class="form-control" maxlength="30" @bind="formulario.Docente.Cargo" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Fecha de nacimiento *</label>
                        <input type="date" class="form-control" @bind="formulario.Docente.FechaNacimiento"
                               @bind:format="yyyy-MM-dd" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Correo electrónico *</label>
                        <input type="email" class="form-control" maxlength="70" @bind="formulario.Docente.Correo" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Teléfono *</label>
                        <input class="form-control" maxlength="20" @bind="formulario.Docente.Telefono" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">URL CvLAC *</label>
                        <input type="url" class="form-control" maxlength="128" @bind="formulario.Docente.UrlCvlac" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Escalafón *</label>
                        <input class="form-control" maxlength="45" @bind="formulario.Docente.Escalafon" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Categoría Minciencias</label>
                        <input class="form-control" maxlength="45" @bind="formulario.Docente.CatMinciencia" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Convocatoria Minciencias *</label>
                        <input class="form-control" maxlength="45" @bind="formulario.Docente.ConvMinciencia" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Nacionalidad *</label>
                        <input class="form-control" maxlength="45" @bind="formulario.Docente.Nacionalidaad" />
                    </div>
                    <div class="col-md-12">
                        <label class="form-label">
                            Línea de investigación principal
                        </label>
                        <select class="form-select" @bind="formulario.Docente.LineaInvestigacionPrincipal">
                            <option value="">(Ninguna)</option>
                            @foreach (var linea in lineas)
                            {
                                <option value="@linea.Id">
                                    @linea.Nombre
                                </option>
                            }
                        </select>
                    </div>
                    <div class="col-12">
                        <label class="form-label">Perfil profesional *</label>
                        <textarea class="form-control" rows="3" @bind="formulario.Docente.Perfil"></textarea>
                    </div>
                </div>
            </div>
        </div>
    }
    <!-- PESTAÑA 2: ESTUDIOS -->
    @if (pestana == "estudios")
    {
        <div class="card maestro-card">
            <div class="card-header">
                <h4>2. Estudios realizados</h4>
                <small>Debe agregar como mínimo un estudio.</small>
            </div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label">Título obtenido *</label>
                        <input class="form-control" maxlength="45" @bind="nuevoEstudio.Titulo" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Universidad *</label>
                        <input class="form-control" maxlength="50" @bind="nuevoEstudio.Universidad" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Fecha de grado *</label>
                        <input type="date" class="form-control" @bind="nuevoEstudio.Fecha" @bind:format="yyyy-MM-dd" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Tipo de estudio *</label>
                        <select class="form-select" @bind="nuevoEstudio.Tipo">
                            <option value="">Seleccione</option>
                            <option value="Pregrado">Pregrado</option>
                            <option value="Especialización">Especialización</option>
                            <option value="Maestría">Maestría</option>
                            <option value="Doctorado">Doctorado</option>
                            <option value="Posdoctorado">Posdoctorado</option>
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Metodología *</label>
                        <select class="form-select" @bind="nuevoEstudio.Metodologia">
                            <option value="">Seleccione</option>
                            <option value="Presencial">Presencial</option>
                            <option value="Virtual">Virtual</option>
                            <option value="Distancia">Distancia</option>
                            <option value="Híbrida">Híbrida</option>
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Ciudad *</label>
                        <input class="form-control" maxlength="45" @bind="nuevoEstudio.Ciudad" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">País *</label>
                        <input class="form-control" maxlength="45" @bind="nuevoEstudio.Pais" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Institución acreditada</label>
                        <select class="form-select" @bind="nuevoEstudio.InsAcreditada">
                            <option value="0">No</option>
                            <option value="1">Sí</option>
                        </select>
                    </div>
                    <div class="col-12">
                        <label class="form-label">Perfil del egresado *</label>
                        <textarea class="form-control" rows="2" @bind="nuevoEstudio.PerfilEgresado"></textarea>
                    </div>
                    <div class="col-12">
                        <button type="button" class="btn btn-agregar-detalle" disabled="@guardando" @onclick="AgregarEstudio">
                            @(editandoEstudio is not null ? "Guardar cambios" : "+ Agregar estudio")
                        </button>
                        @if (editandoEstudio is not null)
                        {
                            <button type="button" class="btn btn-cancelar ms-2" disabled="@guardando"
                                    @onclick="CancelarEdicionEstudio">Cancelar edición</button>
                        }
                    </div>
                </div>
                @if (formulario.Estudios.Count > 0)
                {
                    <div class="table-responsive mt-4">
                        <table class="table table-striped table-bordered align-middle">
                            <thead class="table-light">
                                <tr>
                                    <th>Título</th>
                                    <th>Universidad</th>
                                    <th>Tipo</th>
                                    <th>Fecha</th>
                                    <th>Acción</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var estudio in formulario.Estudios)
                                {
                                    <tr>
                                        <td>@estudio.Titulo</td>
                                        <td>@estudio.Universidad</td>
                                        <td>@estudio.Tipo</td>
                                        <td>@estudio.Fecha?.ToString("dd/MM/yyyy")</td>
                                        <td>
                                            @if (editando)
                                            {
                                                <button type="button" class="btn btn-editar-detalle btn-sm me-1"
                                                        disabled="@guardando" @onclick="() => SeleccionarEstudio(estudio)">Editar</button>
                                            }
                                            <button type="button" class="btn btn-quitar-detalle btn-sm" disabled="@guardando"
                                                    @onclick="() => QuitarEstudio(estudio)">
                                                Quitar
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <p class="text-muted mt-3">
                        Todavía no se han agregado estudios.
                    </p>
                }
            </div>
        </div>
    }
    <!-- PESTAÑA 3: EVALUACIONES -->
    @if (pestana == "evaluaciones")
    {
        <div class="card maestro-card">
            <div class="card-header">
                <h4>3. Evaluaciones docentes</h4>
                <small>Debe agregar como mínimo una evaluación.</small>
            </div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label">Semestre académico *</label>
                        <input class="form-control" maxlength="45" placeholder="Ejemplo: 2026-2"
                               @bind="nuevaEvaluacion.Semestre" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Calificación *</label>
                        <input type="number" min="0" max="5" step="0.1" class="form-control"
                               @bind="nuevaEvaluacion.Calificacion" />
                    </div>
                    <div class="col-12">
                        <button type="button" class="btn btn-agregar-detalle" disabled="@guardando" @onclick="AgregarEvaluacion">
                            @(editandoEvaluacion is not null ? "Guardar cambios" : "+ Agregar evaluación")
                        </button>
                        @if (editandoEvaluacion is not null)
                        {
                            <button type="button" class="btn btn-cancelar ms-2" disabled="@guardando"
                                    @onclick="CancelarEdicionEvaluacion">Cancelar edición</button>
                        }
                    </div>
                </div>
                @if (formulario.Evaluaciones.Count > 0)
                {
                    <div class="table-responsive mt-4">
                        <table class="table table-striped table-bordered">
                            <thead class="table-light">
                                <tr>
                                    <th>Semestre</th>
                                    <th>Calificación</th>
                                    <th>Acción</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var evaluacion in formulario.Evaluaciones)
                                {
                                    <tr>
                                        <td>@evaluacion.Semestre</td>
                                        <td>@evaluacion.Calificacion</td>
                                        <td>
                                            @if (editando)
                                            {
                                                <button type="button" class="btn btn-editar-detalle btn-sm me-1"
                                                        disabled="@guardando" @onclick="() => SeleccionarEvaluacion(evaluacion)">Editar</button>
                                            }
                                            <button type="button" class="btn btn-quitar-detalle btn-sm" disabled="@guardando"
                                                    @onclick="() => QuitarEvaluacion(evaluacion)">
                                                Quitar
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <p class="text-muted mt-3">
                        Todavía no se han agregado evaluaciones.
                    </p>
                }
            </div>
        </div>
    }
    <!-- PESTAÑA 4: EXPERIENCIA -->
    @if (pestana == "experiencias")
    {
        <div class="card maestro-card">
            <div class="card-header">
                <h4>4. Experiencia profesional</h4>
                <small>Debe agregar como mínimo una experiencia.</small>
            </div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label">Nombre del cargo *</label>
                        <input class="form-control" maxlength="45" @bind="nuevaExperiencia.NombreCargo" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Institución *</label>
                        <input class="form-control" maxlength="45" @bind="nuevaExperiencia.Institucion" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Tipo de experiencia *</label>
                        <input class="form-control" maxlength="45" @bind="nuevaExperiencia.Tipo" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Fecha de inicio *</label>
                        <input type="date" class="form-control" @bind="nuevaExperiencia.FechaInicio"
                               @bind:format="yyyy-MM-dd" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Fecha de finalización</label>
                        <input type="date" class="form-control" @bind="nuevaExperiencia.FechaFin"
                               @bind:format="yyyy-MM-dd" />
                        <small class="text-muted">
                            Déjela vacía si continúa trabajando.
                        </small>
                    </div>
                    <div class="col-12">
                        <button type="button" class="btn btn-agregar-detalle" disabled="@guardando" @onclick="AgregarExperiencia">
                            @(editandoExperiencia is not null ? "Guardar cambios" : "+ Agregar experiencia")
                        </button>
                        @if (editandoExperiencia is not null)
                        {
                            <button type="button" class="btn btn-cancelar ms-2" disabled="@guardando"
                                    @onclick="CancelarEdicionExperiencia">Cancelar edición</button>
                        }
                    </div>
                </div>
                @if (formulario.Experiencias.Count > 0)
                {
                    <div class="table-responsive mt-4">
                        <table class="table table-striped table-bordered">
                            <thead class="table-light">
                                <tr>
                                    <th>Cargo</th>
                                    <th>Institución</th>
                                    <th>Inicio</th>
                                    <th>Finalización</th>
                                    <th>Acción</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var experiencia in formulario.Experiencias)
                                {
                                    <tr>
                                        <td>@experiencia.NombreCargo</td>
                                        <td>@experiencia.Institucion</td>
                                        <td>@experiencia.FechaInicio?.ToString("dd/MM/yyyy")</td>
                                        <td>
                                            @(experiencia.FechaFin?.ToString("dd/MM/yyyy") ?? "Actualidad")
                                        </td>
                                        <td>
                                            @if (editando)
                                            {
                                                <button type="button" class="btn btn-editar-detalle btn-sm me-1"
                                                        disabled="@guardando" @onclick="() => SeleccionarExperiencia(experiencia)">Editar</button>
                                            }
                                            <button type="button" class="btn btn-quitar-detalle btn-sm" disabled="@guardando"
                                                    @onclick="() => QuitarExperiencia(experiencia)">
                                                Quitar
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <p class="text-muted mt-3">
                        Todavía no se han agregado experiencias.
                    </p>
                }
            </div>
        </div>
    }
    <!-- PESTAÑA 5: RECONOCIMIENTOS -->
    @if (pestana == "reconocimientos")
    {
        <div class="card maestro-card">
            <div class="card-header">
                <h4>5. Reconocimientos académicos</h4>
                <small>Debe agregar como mínimo un reconocimiento.</small>
            </div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label">Nombre del reconocimiento *</label>
                        <input class="form-control" maxlength="45" @bind="nuevoReconocimiento.Nombre" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Institución *</label>
                        <input class="form-control" maxlength="45" @bind="nuevoReconocimiento.Institucion" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Tipo *</label>
                        <input class="form-control" maxlength="45" @bind="nuevoReconocimiento.Tipo" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Ámbito *</label>
                        <input class="form-control" maxlength="45" @bind="nuevoReconocimiento.Ambito" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Fecha *</label>
                        <input type="date" class="form-control" @bind="nuevoReconocimiento.Fecha"
                               @bind:format="yyyy-MM-dd" />
                    </div>
                    <div class="col-12">
                        <button type="button" class="btn btn-agregar-detalle" disabled="@guardando"
                                @onclick="AgregarReconocimiento">
                            @(editandoReconocimiento is not null ? "Guardar cambios" : "+ Agregar reconocimiento")
                        </button>
                        @if (editandoReconocimiento is not null)
                        {
                            <button type="button" class="btn btn-cancelar ms-2" disabled="@guardando"
                                    @onclick="CancelarEdicionReconocimiento">Cancelar edición</button>
                        }
                    </div>
                </div>
                @if (formulario.Reconocimientos.Count > 0)
                {
                    <div class="table-responsive mt-4">
                        <table class="table table-striped table-bordered">
                            <thead class="table-light">
                                <tr>
                                    <th>Nombre</th>
                                    <th>Institución</th>
                                    <th>Fecha</th>
                                    <th>Acción</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var reconocimiento in formulario.Reconocimientos)
                                {
                                    <tr>
                                        <td>@reconocimiento.Nombre</td>
                                        <td>@reconocimiento.Institucion</td>
                                        <td>@reconocimiento.Fecha?.ToString("dd/MM/yyyy")</td>
                                        <td>
                                            @if (editando)
                                            {
                                                <button type="button" class="btn btn-editar-detalle btn-sm me-1"
                                                        disabled="@guardando" @onclick="() => SeleccionarReconocimiento(reconocimiento)">Editar</button>
                                            }
                                            <button type="button" class="btn btn-quitar-detalle btn-sm" disabled="@guardando"
                                                    @onclick="() => QuitarReconocimiento(reconocimiento)">
                                                Quitar
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <p class="text-muted mt-3">
                        Todavía no se han agregado reconocimientos.
                    </p>
                }
            </div>
        </div>
    }
    <!-- RESUMEN Y GUARDADO -->
    <div class="card maestro-resumen">
        <div class="card-body">
            <h5 class="mb-3">@(editando ? "Edición del docente" : "Estado del registro")</h5>
            <div class="resumen-contadores">
                <span class="estado @(formulario.Estudios.Count > 0 ? "completo" : "pendiente")">
                    @(formulario.Estudios.Count > 0 ? "✓" : "○")
                    Estudios: @formulario.Estudios.Count
                </span>
                <span class="estado @(formulario.Evaluaciones.Count > 0 ? "completo" : "pendiente")">
                    @(formulario.Evaluaciones.Count > 0 ? "✓" : "○")
                    Evaluaciones: @formulario.Evaluaciones.Count
                </span>
                <span class="estado @(formulario.Experiencias.Count > 0 ? "completo" : "pendiente")">
                    @(formulario.Experiencias.Count > 0 ? "✓" : "○")
                    Experiencias: @formulario.Experiencias.Count
                </span>
                <span class="estado @(formulario.Reconocimientos.Count > 0 ? "completo" : "pendiente")">
                    @(formulario.Reconocimientos.Count > 0 ? "✓" : "○")
                    Reconocimientos: @formulario.Reconocimientos.Count
                </span>
            </div>
            <div class="resumen-botones mt-3">
                <button type="button" class="btn btn-guardar-maestro" disabled="@(guardando || cargandoDetallesEdicion)" @onclick="GuardarTodo">
                    @(guardando ? "Guardando..." : editando ? "Actualizar docente y detalles" : "Guardar docente y detalles")
                </button>
                <button type="button" class="btn btn-cancelar" disabled="@guardando" @onclick="Limpiar">
                    Limpiar formulario
                </button>
            </div>
            @if (!DetallesCompletos)
            {
                <small class="text-muted d-block mt-2">
                    Debe agregar al menos un registro en cada sección
                    antes de guardar.
                </small>
            }
        </div>
    </div>
    }
    @if (Sesion.Autenticado)
    {
    <!-- LISTADO DE DOCENTES REGISTRADOS -->
    <div class="card maestro-card mt-4" id="listado-docentes">
        <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
            <div>
                <h4>Docentes registrados (@docentesFiltrados.Count)</h4>
                <small>Consulte, edite o retire docentes.</small>
            </div>
            <button type="button" class="btn btn-actualizar-listado btn-sm"
                    disabled="@guardando" @onclick="CargarDocentes">
                Actualizar listado
            </button>
        </div>
        <div class="card-body">
            <div class="row mb-3">
                <div class="col-md-6">
                    <input class="form-control"
                           placeholder="Buscar por cédula, nombre, correo o cargo"
                           @bind="busqueda" @bind:event="oninput" />
                </div>
                <div class="col-md-3 ms-md-auto">
                    <label class="form-label small mb-1" for="tamanioPaginaDocentes">Registros por página</label>
                    <select id="tamanioPaginaDocentes" class="form-select form-select-sm" @bind="tamanioPagina">
                        <option value="5">5</option>
                        <option value="10">10</option>
                        <option value="20">20</option>
                        <option value="50">50</option>
                    </select>
                </div>
            </div>
            @if (cargandoDocentes)
            {
                <p class="text-muted">Cargando docentes...</p>
            }
            else if (docentesFiltrados.Count == 0)
            {
                <p class="text-muted">No se encontraron docentes.</p>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-striped table-bordered align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>Cédula</th>
                                <th>Nombres</th>
                                <th>Apellidos</th>
                                <th>Correo</th>
                                <th>Cargo</th>
                                <th>Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in docentesPagina)
                            {
                                <tr @key="item.Cedula">
                                    <td>@item.Cedula</td>
                                    <td>@item.Nombres</td>
                                    <td>@item.Apellidos</td>
                                    <td>@item.Correo</td>
                                    <td>@item.Cargo</td>
                                    <td>
                                        @if (PuedeModificar)
                                        {
                                        <div class="d-flex flex-wrap gap-2">
                                            <button type="button"
                                                    class="btn btn-editar-docente btn-sm"
                                                    disabled="@guardando"
                                                    @onclick="() => EditarDocente(item)">
                                                ✏️ Editar
                                            </button>
                                            @if (cedulaPorRetirar == item.Cedula)
                                            {
                                                <button type="button"
                                                        class="btn btn-retirar btn-sm"
                                                        disabled="@guardando"
                                                        @onclick="() => RetirarDocente(item.Cedula)">
                                                    Confirmar retiro
                                                </button>
                                                <button type="button"
                                                        class="btn btn-cancelar btn-sm"
                                                        @onclick="CancelarRetiro">
                                                    Cancelar
                                                </button>
                                            }
                                            else
                                            {
                                                <button type="button"
                                                        class="btn btn-retirar btn-sm"
                                                        disabled="@guardando"
                                                        @onclick="() => SolicitarRetiro(item.Cedula)">
                                                    🗑️ Retirar
                                                </button>
                                            }
                                        </div>
                                        }
                                        else
                                        {
                                            <span class="text-muted small">Solo consulta</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mt-3">
                    <small class="text-muted">
                        Mostrando @(((paginaActualSegura - 1) * tamanioPagina) + 1)–@(Math.Min(paginaActualSegura * tamanioPagina, docentesFiltrados.Count))
                        de @docentesFiltrados.Count docentes
                    </small>
                    <div class="d-flex align-items-center gap-2" aria-label="Paginación de docentes">
                        <button type="button" class="btn btn-outline-secondary btn-sm"
                                disabled="@(paginaActualSegura <= 1)"
                                @onclick="PaginaAnterior">Anterior</button>
                        <span class="small">Página @paginaActualSegura de @totalPaginas</span>
                        <button type="button" class="btn btn-outline-secondary btn-sm"
                                disabled="@(paginaActualSegura >= totalPaginas)"
                                @onclick="PaginaSiguiente">Siguiente</button>
                    </div>
                </div>
            }
        </div>
    </div>
    }
</div>
