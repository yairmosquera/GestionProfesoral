@code {
    // ============================================
    // VARIABLES DEL FORMULARIO
    // ============================================
    private bool PuedeModificar => Sesion.TieneRol("ADMIN", "GESTOR");
    private string pestana = "datos";
    private bool editando;
    private bool cargandoDetallesEdicion;
    private EstudioMaestroDto? editandoEstudio;
    private EvaluacionMaestroDto? editandoEvaluacion;
    private ExperienciaMaestroDto? editandoExperiencia;
    private ReconocimientoMaestroDto? editandoReconocimiento;
    private readonly Dictionary<EstudioMaestroDto,int> idEstudios = new();
    private readonly Dictionary<EvaluacionMaestroDto,int> idEvaluaciones = new();
    private readonly Dictionary<ExperienciaMaestroDto,int> idExperiencias = new();
    private readonly Dictionary<ReconocimientoMaestroDto,int> idReconocimientos = new();
    private readonly HashSet<int> estudiosRetirados = new();
    private readonly HashSet<int> evaluacionesRetiradas = new();
    private readonly HashSet<int> experienciasRetiradas = new();
    private readonly HashSet<int> reconocimientosRetirados = new();
    private bool cargandoDocentes;
    private List<DocenteDto> docentes = new();
    private string busqueda = "";
    private int? cedulaPorRetirar;
    private int paginaActual = 1;
    private int tamanioPagina = 10;
    private int totalPaginas => Math.Max(1, (int)Math.Ceiling((double)docentesFiltrados.Count / tamanioPagina));
    private int paginaActualSegura => Math.Clamp(paginaActual, 1, totalPaginas);
    private List<DocenteDto> docentesPagina => docentesFiltrados
        .Skip((paginaActualSegura - 1) * tamanioPagina)
        .Take(tamanioPagina)
        .ToList();
    private void PaginaAnterior() => paginaActual = Math.Max(1, paginaActualSegura - 1);
    private void PaginaSiguiente() => paginaActual = Math.Min(totalPaginas, paginaActualSegura + 1);
    private List<DocenteDto> docentesFiltrados => docentes
        .Where(d => string.IsNullOrWhiteSpace(busqueda) ||
            d.Cedula.ToString().Contains(busqueda.Trim(), StringComparison.OrdinalIgnoreCase) ||
            d.Nombres.Contains(busqueda.Trim(), StringComparison.OrdinalIgnoreCase) ||
            d.Apellidos.Contains(busqueda.Trim(), StringComparison.OrdinalIgnoreCase) ||
            d.Correo.Contains(busqueda.Trim(), StringComparison.OrdinalIgnoreCase) ||
            d.Cargo.Contains(busqueda.Trim(), StringComparison.OrdinalIgnoreCase))
        .ToList();
    private DocenteMaestroDto formulario = new();
    private EstudioMaestroDto nuevoEstudio = new();
    private EvaluacionMaestroDto nuevaEvaluacion = new();
    private ExperienciaMaestroDto nuevaExperiencia = new();
    private ReconocimientoMaestroDto nuevoReconocimiento = new();
    private List<LineaInvestigacionDto> lineas = new();
    private bool guardando;
    private bool esError;
    private string mensaje = "";
    // Indica si todas las secciones tienen registros.
    private bool DetallesCompletos =>
        formulario.Estudios.Count > 0 &&
        formulario.Evaluaciones.Count > 0 &&
        formulario.Experiencias.Count > 0 &&
        formulario.Reconocimientos.Count > 0;
    // ============================================
    // CARGAR LÍNEAS DE INVESTIGACIÓN
    // ============================================
    protected override async Task OnInitializedAsync()
    {
        try
        {
            lineas = await ServicioLineas.ObtenerTodosAsync();
        }
        catch (Exception)
        {
            MostrarError(
                "No fue posible cargar las líneas de investigación.");
        }
        if (Sesion.Autenticado)
            await CargarDocentes();
    }
    private async Task CargarDocentes()
    {
        if (!Sesion.Autenticado)
            return;
        cargandoDocentes = true;
        try
        {
            docentes = await ServicioDocentes.Listar();
        }
        catch (Exception)
        {
            MostrarError("No fue posible cargar el listado de docentes.");
        }
        finally
        {
            cargandoDocentes = false;
        }
    }
    // ============================================
    // CAMBIAR PESTAÑA
    // ============================================
    private void CambiarPestana(string nuevaPestana)
    {
        if (guardando)
            return;
                pestana = nuevaPestana;
    }
    // ============================================
    // AGREGAR ESTUDIO
    // ============================================
    private void AgregarEstudio()
    {
        if (!PuedeModificar) return;
        if (string.IsNullOrWhiteSpace(nuevoEstudio.Titulo) ||
            string.IsNullOrWhiteSpace(nuevoEstudio.Universidad) ||
            string.IsNullOrWhiteSpace(nuevoEstudio.Tipo) ||
            string.IsNullOrWhiteSpace(nuevoEstudio.Ciudad) ||
            string.IsNullOrWhiteSpace(nuevoEstudio.Pais) ||
            string.IsNullOrWhiteSpace(nuevoEstudio.Metodologia) ||
            string.IsNullOrWhiteSpace(nuevoEstudio.PerfilEgresado) ||
            !nuevoEstudio.Fecha.HasValue)
        {
            MostrarError(
                "Complete todos los campos obligatorios del estudio.");
            return;
        }
        if (editandoEstudio is not null)
        {
            var posicion = formulario.Estudios.IndexOf(editandoEstudio);
            if (posicion >= 0)
            {
                if (idEstudios.TryGetValue(editandoEstudio, out var id))
                {
                    idEstudios.Remove(editandoEstudio);
                    idEstudios[nuevoEstudio] = id;
                }
                formulario.Estudios[posicion] = nuevoEstudio;
            }
        }
        else
        {
            formulario.Estudios.Add(nuevoEstudio);
        }
        editandoEstudio = null;
        nuevoEstudio = new();
        LimpiarMensaje();
    }
    private void QuitarEstudio(EstudioMaestroDto estudio)
    {
        if (!PuedeModificar) return;
        if (idEstudios.TryGetValue(estudio, out var id))
        {
            estudiosRetirados.Add(id);
            idEstudios.Remove(estudio);
        }
        formulario.Estudios.Remove(estudio);
        if (ReferenceEquals(editandoEstudio, estudio))
            CancelarEdicionEstudio();
    }
    // ============================================
    // AGREGAR EVALUACIÓN
    // ============================================
    private void AgregarEvaluacion()
    {
        if (!PuedeModificar) return;
        if (string.IsNullOrWhiteSpace(nuevaEvaluacion.Semestre) ||
            nuevaEvaluacion.Calificacion < 0 ||
            nuevaEvaluacion.Calificacion > 5)
        {
            MostrarError(
                "Ingrese un semestre y una calificación entre 0 y 5.");
            return;
        }
        if (editandoEvaluacion is not null)
        {
            var posicion = formulario.Evaluaciones.IndexOf(editandoEvaluacion);
            if (posicion >= 0)
            {
                if (idEvaluaciones.TryGetValue(editandoEvaluacion, out var id))
                {
                    idEvaluaciones.Remove(editandoEvaluacion);
                    idEvaluaciones[nuevaEvaluacion] = id;
                }
                formulario.Evaluaciones[posicion] = nuevaEvaluacion;
            }
        }
        else
        {
            formulario.Evaluaciones.Add(nuevaEvaluacion);
        }
        editandoEvaluacion = null;
        nuevaEvaluacion = new();
        LimpiarMensaje();
    }
    private void QuitarEvaluacion(
        EvaluacionMaestroDto evaluacion)
    {
        if (idEvaluaciones.TryGetValue(evaluacion, out var id))
        {
            evaluacionesRetiradas.Add(id);
            idEvaluaciones.Remove(evaluacion);
        }
        formulario.Evaluaciones.Remove(evaluacion);
        if (ReferenceEquals(editandoEvaluacion, evaluacion))
            CancelarEdicionEvaluacion();
    }
    // ============================================
    // AGREGAR EXPERIENCIA
    // ============================================
    private void AgregarExperiencia()
    {
        if (!PuedeModificar) return;
        if (string.IsNullOrWhiteSpace(nuevaExperiencia.NombreCargo) ||
            string.IsNullOrWhiteSpace(nuevaExperiencia.Institucion) ||
            string.IsNullOrWhiteSpace(nuevaExperiencia.Tipo) ||
            !nuevaExperiencia.FechaInicio.HasValue)
        {
            MostrarError(
                "Complete los campos obligatorios de la experiencia.");
            return;
        }
        if (nuevaExperiencia.FechaFin.HasValue &&
            nuevaExperiencia.FechaFin.Value.Date <
            nuevaExperiencia.FechaInicio.Value.Date)
        {
            MostrarError(
                "La fecha final no puede ser anterior a la inicial.");
            return;
        }
        if (editandoExperiencia is not null)
        {
            var posicion = formulario.Experiencias.IndexOf(editandoExperiencia);
            if (posicion >= 0)
            {
                if (idExperiencias.TryGetValue(editandoExperiencia, out var id))
                {
                    idExperiencias.Remove(editandoExperiencia);
                    idExperiencias[nuevaExperiencia] = id;
                }
                formulario.Experiencias[posicion] = nuevaExperiencia;
            }
        }
        else
        {
            formulario.Experiencias.Add(nuevaExperiencia);
        }
        editandoExperiencia = null;
        nuevaExperiencia = new();
        LimpiarMensaje();
    }
    private void QuitarExperiencia(
        ExperienciaMaestroDto experiencia)
    {
        if (idExperiencias.TryGetValue(experiencia, out var id))
        {
            experienciasRetiradas.Add(id);
            idExperiencias.Remove(experiencia);
        }
        formulario.Experiencias.Remove(experiencia);
        if (ReferenceEquals(editandoExperiencia, experiencia))
            CancelarEdicionExperiencia();
    }
    // ============================================
    // AGREGAR RECONOCIMIENTO
    // ============================================
    private void AgregarReconocimiento()
    {
        if (!PuedeModificar) return;
        if (string.IsNullOrWhiteSpace(nuevoReconocimiento.Nombre) ||
            string.IsNullOrWhiteSpace(nuevoReconocimiento.Institucion) ||
            string.IsNullOrWhiteSpace(nuevoReconocimiento.Tipo) ||
            string.IsNullOrWhiteSpace(nuevoReconocimiento.Ambito) ||
            !nuevoReconocimiento.Fecha.HasValue)
        {
            MostrarError(
                "Complete los campos obligatorios del reconocimiento.");
            return;
        }
        if (editandoReconocimiento is not null)
        {
            var posicion = formulario.Reconocimientos.IndexOf(editandoReconocimiento);
            if (posicion >= 0)
            {
                if (idReconocimientos.TryGetValue(editandoReconocimiento, out var id))
                {
                    idReconocimientos.Remove(editandoReconocimiento);
                    idReconocimientos[nuevoReconocimiento] = id;
                }
                formulario.Reconocimientos[posicion] = nuevoReconocimiento;
            }
        }
        else
        {
            formulario.Reconocimientos.Add(nuevoReconocimiento);
        }
        editandoReconocimiento = null;
        nuevoReconocimiento = new();
        LimpiarMensaje();
    }
    private void QuitarReconocimiento(
        ReconocimientoMaestroDto reconocimiento)
    {
        if (idReconocimientos.TryGetValue(reconocimiento, out var id))
        {
            reconocimientosRetirados.Add(id);
            idReconocimientos.Remove(reconocimiento);
        }
        formulario.Reconocimientos.Remove(reconocimiento);
        if (ReferenceEquals(editandoReconocimiento, reconocimiento))
            CancelarEdicionReconocimiento();
    }
