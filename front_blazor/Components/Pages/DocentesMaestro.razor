    // GUARDAR DOCENTE Y TODOS SUS DETALLES
    // ============================================
    private async Task GuardarTodo()
    {
        if (!PuedeModificar)
        {
            MostrarError("No tienes permiso para modificar docentes.");
            return;
        }
        if (guardando)
            return;
        var docente = formulario.Docente;
        var camposFaltantes = new List<string>();
        if (docente.Cedula <= 0)
            camposFaltantes.Add("Cédula");
        if (string.IsNullOrWhiteSpace(docente.Nombres))
            camposFaltantes.Add("Nombres");
        if (string.IsNullOrWhiteSpace(docente.Apellidos))
            camposFaltantes.Add("Apellidos");
        if (string.IsNullOrWhiteSpace(docente.Genero))
            camposFaltantes.Add("Género");
        if (string.IsNullOrWhiteSpace(docente.Cargo))
            camposFaltantes.Add("Cargo");
        if (docente.FechaNacimiento == default)
            camposFaltantes.Add("Fecha de nacimiento");
        if (string.IsNullOrWhiteSpace(docente.Correo))
            camposFaltantes.Add("Correo electrónico");
        if (string.IsNullOrWhiteSpace(docente.Telefono))
            camposFaltantes.Add("Teléfono");
        if (string.IsNullOrWhiteSpace(docente.UrlCvlac))
            camposFaltantes.Add("URL CvLAC");
        if (string.IsNullOrWhiteSpace(docente.Escalafon))
            camposFaltantes.Add("Escalafón");
        if (string.IsNullOrWhiteSpace(docente.Perfil))
            camposFaltantes.Add("Perfil profesional");
        if (string.IsNullOrWhiteSpace(docente.ConvMinciencia))
            camposFaltantes.Add("Convocatoria Minciencias");
        if (string.IsNullOrWhiteSpace(docente.Nacionalidaad))
            camposFaltantes.Add("Nacionalidad");
        if (camposFaltantes.Count > 0)
        {
            pestana = "datos";
            MostrarError("Faltan los siguientes campos del docente: " +
                string.Join(", ", camposFaltantes) + ".");
            return;
        }
        if (docente.FechaNacimiento.Date >= DateTime.Today)
        {
            pestana = "datos";
            MostrarError("La fecha de nacimiento debe ser anterior a hoy.");
            return;
        }
        if (!new EmailAddressAttribute().IsValid(docente.Correo))
        {
            pestana = "datos";
            MostrarError("El correo electrónico no tiene un formato válido.");
            return;
        }
        if (formulario.Estudios.Count == 0)
        {
            pestana = "estudios";
            MostrarError("Debe agregar al menos un estudio realizado.");
            return;
        }
        if (formulario.Evaluaciones.Count == 0)
        {
            pestana = "evaluaciones";
            MostrarError("Debe agregar al menos una evaluación docente.");
            return;
        }
        if (formulario.Experiencias.Count == 0)
        {
            pestana = "experiencias";
            MostrarError("Debe agregar al menos una experiencia profesional.");
            return;
        }
        if (formulario.Reconocimientos.Count == 0)
        {
            pestana = "reconocimientos";
            MostrarError("Debe agregar al menos un reconocimiento académico.");
            return;
        }
        var contexto = new ValidationContext(docente);
        var resultados = new List<ValidationResult>();
        if (!Validator.TryValidateObject(docente, contexto, resultados, true))
        {
            pestana = "datos";
            MostrarError("Revise los siguientes datos: " +
                string.Join(" | ", resultados.Select(x => x.ErrorMessage)));
            return;
        }
        guardando = true;
        LimpiarMensaje();
        try
        {
            if (editando)
            {
                // Construir el pedido maestro-detalle. Los registros existentes
                // llevan su ID; los nuevos se envían con ID nulo.
                var peticion = new
                {
                    Docente = docente,
                    Estudios = formulario.Estudios.Select(x => new
                    {
                        Id = idEstudios.TryGetValue(x, out var id) ? (int?)id : null,
                        x.Titulo, x.Universidad, x.Fecha, x.Tipo, x.Ciudad,
                        x.InsAcreditada, x.Metodologia, x.PerfilEgresado, x.Pais
                    }).ToList(),
                    Evaluaciones = formulario.Evaluaciones.Select(x => new
                    {
                        Id = idEvaluaciones.TryGetValue(x, out var id) ? (int?)id : null,
                        x.Calificacion, x.Semestre
                    }).ToList(),
                    Experiencias = formulario.Experiencias.Select(x => new
                    {
                        Id = idExperiencias.TryGetValue(x, out var id) ? (int?)id : null,
                        x.NombreCargo, x.Institucion, x.Tipo, x.FechaInicio, x.FechaFin
                    }).ToList(),
                    Reconocimientos = formulario.Reconocimientos.Select(x => new
                    {
                        Id = idReconocimientos.TryGetValue(x, out var id) ? (int?)id : null,
                        x.Tipo, x.Fecha, x.Institucion, x.Nombre, x.Ambito
                    }).ToList(),
                    EstudiosPorRetirar = estudiosRetirados.ToList(),
                    EvaluacionesPorRetirar = evaluacionesRetiradas.ToList(),
                    ExperienciasPorRetirar = experienciasRetiradas.ToList(),
                    ReconocimientosPorRetirar = reconocimientosRetirados.ToList()
                };
                var resultadoEdicion = await ServicioEdicion.Actualizar(docente.Cedula, peticion);
                esError = !resultadoEdicion.Ok;
                mensaje = resultadoEdicion.Mensaje;
                if (resultadoEdicion.Ok)
                {
                    LimpiarDatos();
                    pestana = "datos";
                    await CargarDocentes();
                }
                return;
            }
            var resultado = await ServicioMaestro.Registrar(formulario);
            esError = !resultado.Ok;
            mensaje = resultado.Mensaje;
            if (resultado.Ok)
            {
                LimpiarDatos();
                pestana = "datos";
                await CargarDocentes();
            }
        }
        catch (Exception)
        {
            MostrarError("Ocurrió un error al registrar el docente y sus detalles.");
        }
        finally
        {
            guardando = false;
        }
    }
    // ============================================
    private async Task EditarDocente(DocenteDto item)
    {
        if (!PuedeModificar)
        {
            MostrarError("No tienes permiso para modificar docentes.");
            return;
        }
        if (guardando || cargandoDetallesEdicion) return;
        cargandoDetallesEdicion = true;
        List<EstudioRealizadoDto> estudios;
        List<EvaluacionDocenteDto> evaluaciones;
        List<ExperienciaDocenteDto> experiencias;
        List<ReconocimientoDocenteDto> reconocimientos;
        string seccion = "Estudios";
        try
        {
            // Consultar una sección a la vez para identificar
            // exactamente qué petición HTTP está fallando.
            estudios = await ServicioEstudios.PorDocente(item.Cedula);

            seccion = "Evaluaciones";
            evaluaciones = await ServicioEvaluaciones.PorDocente(item.Cedula);

            seccion = "Experiencias";
            experiencias = await ServicioExperiencias.PorDocente(item.Cedula);

            seccion = "Reconocimientos";
            reconocimientos = await ServicioReconocimientos.PorDocente(item.Cedula);
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine(
                $"Error al cargar {seccion} del docente {item.Cedula}: {ex}");

            MostrarError(
                $"Error al cargar {seccion} del docente {item.Cedula}: {ex.Message}");

            cargandoDetallesEdicion = false;
            return;
        }
        cargandoDetallesEdicion = false;
        LimpiarDatos();
        editando = true;
        cedulaPorRetirar = null;
        pestana = "datos";
        LimpiarMensaje();
        formulario = new DocenteMaestroDto
        {
            Docente = new DocenteDto
            {
                Cedula = item.Cedula,
                Nombres = item.Nombres,
                Apellidos = item.Apellidos,
                Genero = item.Genero,
                Cargo = item.Cargo,
                FechaNacimiento = item.FechaNacimiento,
                Correo = item.Correo,
                Telefono = item.Telefono,
                UrlCvlac = item.UrlCvlac,
                Escalafon = item.Escalafon,
                Perfil = item.Perfil,
                CatMinciencia = item.CatMinciencia,
                ConvMinciencia = item.ConvMinciencia,
                Nacionalidaad = item.Nacionalidaad,
                LineaInvestigacionPrincipal = item.LineaInvestigacionPrincipal,
                Activo = item.Activo
            }
        };
        foreach (var e in estudios)
        {
            var x = new EstudioMaestroDto
            {
                Titulo=e.Titulo, Universidad=e.Universidad, Fecha=e.Fecha,
                Tipo=e.Tipo, Ciudad=e.Ciudad, InsAcreditada=e.InsAcreditada,
                Metodologia=e.Metodologia, PerfilEgresado=e.PerfilEgresado, Pais=e.Pais
            };
            formulario.Estudios.Add(x);
            idEstudios[x] = e.Id;
        }
        foreach (var e in evaluaciones)
        {
            var x = new EvaluacionMaestroDto { Calificacion=e.Calificacion, Semestre=e.Semestre };
            formulario.Evaluaciones.Add(x);
            idEvaluaciones[x] = e.Id;
        }
        foreach (var e in experiencias)
        {
            var x = new ExperienciaMaestroDto
            {
                NombreCargo=e.NombreCargo, Institucion=e.Institucion, Tipo=e.Tipo,
                FechaInicio=e.FechaInicio, FechaFin=e.FechaFin
            };
            formulario.Experiencias.Add(x);
            idExperiencias[x] = e.Id;
        }
        foreach (var e in reconocimientos)
        {
            var x = new ReconocimientoMaestroDto
            {
                Nombre=e.Nombre, Institucion=e.Institucion, Tipo=e.Tipo,
                Ambito=e.Ambito, Fecha=e.Fecha
            };
            formulario.Reconocimientos.Add(x);
            idReconocimientos[x] = e.Id;
        }
        nuevoEstudio = new();
        nuevaEvaluacion = new();
        nuevaExperiencia = new();
        nuevoReconocimiento = new();
    }
    private void SolicitarRetiro(int cedula)
    {
        if (!PuedeModificar)
        {
            MostrarError("No tienes permiso para modificar docentes.");
            return;
        }
        cedulaPorRetirar = cedula;
        MostrarError($"Confirme si desea retirar al docente con cédula {cedula}. " +
            "El retiro depende de las restricciones de la base de datos.");
    }
    private void CancelarRetiro()
    {
        cedulaPorRetirar = null;
        LimpiarMensaje();
    }
    private async Task RetirarDocente(int cedula)
    {
        if (!PuedeModificar)
        {
            MostrarError("No tienes permiso para modificar docentes.");
            return;
        }
        if (guardando || cedulaPorRetirar != cedula) return;
        guardando = true;
        try
        {
            var resultado = await ServicioDocentes.Eliminar(cedula);
            esError = !resultado.Ok;
            mensaje = resultado.Mensaje;
            cedulaPorRetirar = null;
            if (resultado.Ok)
            {
                if (editando && formulario.Docente.Cedula == cedula)
                {
                    LimpiarDatos();
                    pestana = "datos";
                }
                await CargarDocentes();
            }
        }
        catch (Exception)
        {
            MostrarError("No fue posible retirar el docente.");
        }
        finally
        {
            guardando = false;
        }
    }
    private void Limpiar()
    {
        if (guardando)
            return;
        LimpiarDatos();
        LimpiarMensaje();
        pestana = "datos";
    }
    private void LimpiarDatos()
    {
        idEstudios.Clear(); idEvaluaciones.Clear();
        idExperiencias.Clear(); idReconocimientos.Clear();
        estudiosRetirados.Clear(); evaluacionesRetiradas.Clear();
        experienciasRetiradas.Clear(); reconocimientosRetirados.Clear();
        editandoEstudio = null; editandoEvaluacion = null;
        editandoExperiencia = null; editandoReconocimiento = null;
        formulario = new();
        editando = false;
        cedulaPorRetirar = null;
        nuevoEstudio = new();
        nuevaEvaluacion = new();
        nuevaExperiencia = new();
        nuevoReconocimiento = new();
    }
    private void LimpiarMensaje()
    {
        esError = false;
        mensaje = "";
    }
    private void MostrarError(string texto)
    {
        esError = true;
        mensaje = texto;
    }
