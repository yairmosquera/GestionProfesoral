@page "/terminos-clave"
@rendermode InteractiveServer
@using FrontGestion.Servicios
@inject ServicioTerminoClave ServicioTerminoClave

<PageTitle>Términos Clave</PageTitle>

<h1>Gestión de Términos Clave</h1>

@if (!string.IsNullOrWhiteSpace(mensaje))
{
    <div class="alert @claseMensaje">
        @mensaje
    </div>
}

<div class="card mb-4">
    <div class="card-body">

        <h4>
            @(editando
                ? "Editar término clave"
                : "Registrar término clave")
        </h4>

        <div class="row">

            <div class="col-md-6 mb-3">
                <label class="form-label">
                    Término
                </label>

                @if (editando)
                {
                    <input class="form-control" value="@formulario.Termino" disabled />
                }
                else
                {
                    <InputText class="form-control" @bind-Value="formulario.Termino" />
                }
            </div>

            <div class="col-md-6 mb-3">
                <label class="form-label">
                    Término en inglés
                </label>

                <InputText class="form-control" @bind-Value="formulario.TerminoIngles" />
            </div>

        </div>

        <button class="btn btn-primary me-2" @onclick="Guardar">
            @(editando ? "Actualizar" : "Guardar")
        </button>

        @if (editando)
        {
            <button class="btn btn-secondary" @onclick="Cancelar">
                Cancelar
            </button>
        }

    </div>
</div>

<h4>Términos clave registrados</h4>

@if (cargando)
{
    <p>Cargando términos clave...</p>
}
else if (terminos.Count == 0)
{
    <div class="alert alert-info">
        No hay términos clave registrados.
    </div>
}
else
{
    <div class="table-responsive">

        <table class="table table-striped table-bordered">

            <thead>
                <tr>
                    <th>Término</th>
                    <th>Término en inglés</th>
                    <th class="columna-acciones">Acciones</th>
                </tr>
            </thead>

            <tbody>

                @foreach (var termino in terminos)
                {
                    <tr>

                        <td>
                            @termino.Termino
                        </td>

                        <td>
                            @(string.IsNullOrWhiteSpace(
                                termino.TerminoIngles)
                                ? "-"
                                : termino.TerminoIngles)
                        </td>

                        <td class="columna-acciones">

                            <div class="acciones-termino">

                                <button type="button" class="btn btn-warning btn-accion" title="Editar término clave"
                                        @onclick="() => Editar(termino)">
                                    ✏️ Editar
                                </button>

                                <button type="button" class="btn btn-danger btn-accion" title="Retirar término clave"
                                        @onclick="() => Retirar(termino.Termino)">
                                    🗑️ Retirar
                                </button>

                            </div>

                        </td>

                    </tr>
                }

            </tbody>

        </table>

    </div>
}

<!-- ESTILOS SOLO PARA LOS BOTONES EDITAR Y RETIRAR -->

<style>
    .columna-acciones {
        min-width: 240px;
        width: 240px;
        vertical-align: middle;
    }

    .acciones-termino {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 8px;
        width: 100%;
    }

    .acciones-termino .btn-accion {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 100%;
        min-height: 38px;
        padding: 7px 8px;
        border-radius: 6px;
        font-size: 12px;
        font-weight: 600;
        white-space: nowrap;
        transition: background-color 0.2s ease,
            transform 0.2s ease;
    }

    .acciones-termino .btn-warning {
        background-color: #f59e0b;
        border-color: #f59e0b;
        color: #ffffff;
    }

    .acciones-termino .btn-warning:hover {
        background-color: #d97706;
        border-color: #d97706;
        color: #ffffff;
    }

    .acciones-termino .btn-danger {
        background-color: #dc2626;
        border-color: #dc2626;
        color: #ffffff;
    }

    .acciones-termino .btn-danger:hover {
        background-color: #b91c1c;
        border-color: #b91c1c;
        color: #ffffff;
    }

    .acciones-termino .btn-accion:hover {
        transform: translateY(-1px);
    }

    @@media (max-width: 768px) {
        .columna-acciones {
            min-width: 220px;
            width: 220px;
        }

        .acciones-termino {
            gap: 6px;
        }

        .acciones-termino .btn-accion {
            font-size: 11px;
            padding: 7px 5px;
        }
    }
</style>

@code {

    private List<TerminoClaveDto> terminos = new();

    private TerminoFormulario formulario = new();

    private bool cargando = true;

    private bool editando = false;

    private string terminoEdicion = string.Empty;

    private string mensaje = string.Empty;

    private string claseMensaje = "alert-success";

    protected override async Task OnInitializedAsync()
    {
        await CargarTerminos();
    }

    private async Task CargarTerminos()
    {
        try
        {
            cargando = true;

            terminos =
                await ServicioTerminoClave
                    .ObtenerTodosAsync();
        }
        catch
        {
            MostrarError(
                "No fue posible cargar los términos clave."
            );
        }
        finally
        {
            cargando = false;
        }
    }

    private void Editar(
        TerminoClaveDto termino)
    {
        formulario = new TerminoFormulario
        {
            Termino = termino.Termino,
            TerminoIngles = termino.TerminoIngles
        };

        terminoEdicion = termino.Termino;

        editando = true;

        LimpiarMensaje();
    }

    private async Task Guardar()
    {
        LimpiarMensaje();

        if (!editando)
        {
            if (string.IsNullOrWhiteSpace(
                formulario.Termino))
            {
                MostrarError(
                    "El término es obligatorio."
                );

                return;
            }

            if (formulario.Termino.Length > 30)
            {
                MostrarError(
                    "El término no puede superar los 30 caracteres."
                );

                return;
            }
        }

        if (!string.IsNullOrWhiteSpace(
                formulario.TerminoIngles)
            && formulario.TerminoIngles.Length > 30)
        {
            MostrarError(
                "El término en inglés no puede superar los 30 caracteres."
            );

            return;
        }

        if (editando)
        {
            var peticion =
                new TerminoClaveActualizarDto
                {
                    TerminoIngles =
                        string.IsNullOrWhiteSpace(
                            formulario.TerminoIngles)
                            ? null
                            : formulario.TerminoIngles
                };

            var resultado =
                await ServicioTerminoClave
                    .ActualizarAsync(
                        terminoEdicion,
                        peticion
                    );

            if (!resultado.Ok)
            {
                MostrarErrores(
                    resultado.Errores
                );

                return;
            }

            MostrarExito(
                "Término clave actualizado correctamente."
            );
        }
        else
        {
            var peticion =
                new TerminoClaveCrearDto
                {
                    Termino =
                        formulario.Termino,

                    TerminoIngles =
                        string.IsNullOrWhiteSpace(
                            formulario.TerminoIngles)
                            ? null
                            : formulario.TerminoIngles
                };

            var resultado =
                await ServicioTerminoClave
                    .CrearAsync(peticion);

            if (!resultado.Ok)
            {
                MostrarErrores(
                    resultado.Errores
                );

                return;
            }

            MostrarExito(
                "Término clave registrado correctamente."
            );
        }

        LimpiarFormulario();

        await CargarTerminos();
    }

    private async Task Retirar(
        string termino)
    {
        LimpiarMensaje();

        var resultado =
            await ServicioTerminoClave
                .EliminarAsync(termino);

        if (!resultado.Ok)
        {
            MostrarErrores(
                resultado.Errores
            );

            return;
        }

        MostrarExito(
            "Término clave retirado correctamente."
        );

        if (editando &&
            terminoEdicion == termino)
        {
            LimpiarFormulario();
        }

        await CargarTerminos();
    }

    private void Cancelar()
    {
        LimpiarFormulario();
        LimpiarMensaje();
    }

    private void LimpiarFormulario()
    {
        formulario =
            new TerminoFormulario();

        editando = false;

        terminoEdicion =
            string.Empty;
    }

    private void MostrarExito(
        string texto)
    {
        mensaje = texto;

        claseMensaje =
            "alert-success";
    }

    private void MostrarError(
        string texto)
    {
        mensaje = texto;

        claseMensaje =
            "alert-danger";
    }

    private void MostrarErrores(
        List<string> errores)
    {
        mensaje = errores.Count > 0
            ? string.Join(" ", errores)
            : "Ocurrió un error.";

        claseMensaje =
            "alert-danger";
    }

    private void LimpiarMensaje()
    {
        mensaje = string.Empty;
    }

    private class TerminoFormulario
    {
        public string Termino { get; set; }
            = string.Empty;

        public string? TerminoIngles { get; set; }
    }
}
