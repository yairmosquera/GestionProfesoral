@page "/lineas-investigacion"
@rendermode InteractiveServer
@using FrontGestion.Servicios
@inject ServicioLineaInvestigacion ServicioLineaInvestigacion

<PageTitle>Líneas de Investigación</PageTitle>

<h1>Gestión de Líneas de Investigación</h1>

@if (!string.IsNullOrWhiteSpace(mensaje))
{
    <div class="alert @claseMensaje">
        @mensaje
    </div>
}

<div class="card mb-4">
    <div class="card-body">

        <h4>
            @(editando
                ? "Editar línea de investigación"
                : "Registrar línea de investigación")
        </h4>

        <div class="row">

            <div class="col-md-4 mb-3">
                <label class="form-label">Nombre</label>

                <InputText class="form-control" @bind-Value="formulario.Nombre" />
            </div>

            <div class="col-md-8 mb-3">
                <label class="form-label">Descripción</label>

                <InputTextArea class="form-control" rows="3" @bind-Value="formulario.Descripcion" />
            </div>

        </div>

        <button class="btn btn-primary me-2" @onclick="Guardar">

            @(editando ? "Actualizar" : "Guardar")

        </button>

        @if (editando)
        {
            <button class="btn btn-secondary" @onclick="Cancelar">

                Cancelar

            </button>
        }

    </div>
</div>

<h4>Líneas de investigación registradas</h4>

@if (cargando)
{
    <p>Cargando líneas de investigación...</p>
}
else if (lineas.Count == 0)
{
    <div class="alert alert-info">
        No hay líneas de investigación registradas.
    </div>
}
else
{
    <div class="table-responsive">

        <table class="table table-striped table-bordered">

            <thead>
                <tr>
                    <th>ID</th>
                    <th>Nombre</th>
                    <th>Descripción</th>
                    <th>Acciones</th>
                </tr>
            </thead>

            <tbody>

                @foreach (var linea in lineas)
                {
                    <tr>

                        <td>@linea.Id</td>

                        <td>@linea.Nombre</td>

                        <td>@linea.Descripcion</td>

                        <td>
                            <button class="btn btn-sm btn-warning me-2" @onclick="() => Editar(linea)">

                                Editar

                            </button>

                            <button class="btn btn-sm btn-danger" @onclick="() => Retirar(linea.Id)">

                                Retirar

                            </button>
                        </td>

                    </tr>
                }

            </tbody>

        </table>

    </div>
}

@code {

    private List<LineaInvestigacionDto> lineas = new();

    private LineaFormulario formulario = new();

    private bool cargando = true;
    private bool editando = false;

    private int idEdicion;

    private string mensaje = string.Empty;

    private string claseMensaje = "alert-success";

    protected override async Task OnInitializedAsync()
    {
        await CargarLineas();
    }

    private async Task CargarLineas()
    {
        try
        {
            cargando = true;

            lineas =
                await ServicioLineaInvestigacion
                    .ObtenerTodosAsync();
        }
        catch
        {
            MostrarError(
                "No fue posible cargar las líneas de investigación."
            );
        }
        finally
        {
            cargando = false;
        }
    }

    private void Editar(
        LineaInvestigacionDto linea)
    {
        formulario = new LineaFormulario
        {
            Nombre = linea.Nombre,
            Descripcion = linea.Descripcion
        };

        idEdicion = linea.Id;

        editando = true;

        LimpiarMensaje();
    }

    private async Task Guardar()
    {
        LimpiarMensaje();

        if (string.IsNullOrWhiteSpace(
            formulario.Nombre))
        {
            MostrarError(
                "El nombre es obligatorio."
            );

            return;
        }

        if (formulario.Nombre.Length > 45)
        {
            MostrarError(
                "El nombre no puede superar los 45 caracteres."
            );

            return;
        }

        if (string.IsNullOrWhiteSpace(
            formulario.Descripcion))
        {
            MostrarError(
                "La descripción es obligatoria."
            );

            return;
        }

        if (formulario.Descripcion.Length > 256)
        {
            MostrarError(
                "La descripción no puede superar los 256 caracteres."
            );

            return;
        }

        if (editando)
        {
            var peticion =
                new LineaInvestigacionActualizarDto
                {
                    Nombre = formulario.Nombre,
                    Descripcion = formulario.Descripcion
                };

            var resultado =
                await ServicioLineaInvestigacion
                    .ActualizarAsync(
                        idEdicion,
                        peticion
                    );

            if (!resultado.Ok)
            {
                MostrarErrores(
                    resultado.Errores
                );

                return;
            }

            MostrarExito(
                "Línea de investigación actualizada correctamente."
            );
        }
        else
        {
            var peticion =
                new LineaInvestigacionCrearDto
                {
                    Nombre = formulario.Nombre,
                    Descripcion = formulario.Descripcion
                };

            var resultado =
                await ServicioLineaInvestigacion
                    .CrearAsync(peticion);

            if (!resultado.Ok)
            {
                MostrarErrores(
                    resultado.Errores
                );

                return;
            }

            MostrarExito(
                "Línea de investigación registrada correctamente."
            );
        }

        LimpiarFormulario();

        await CargarLineas();
    }

    private async Task Retirar(int id)
    {
        LimpiarMensaje();

        var resultado =
            await ServicioLineaInvestigacion
                .EliminarAsync(id);

        if (!resultado.Ok)
        {
            MostrarErrores(
                resultado.Errores
            );

            return;
        }

        MostrarExito(
            "Línea de investigación retirada correctamente."
        );

        if (editando && idEdicion == id)
        {
            LimpiarFormulario();
        }

        await CargarLineas();
    }

    private void Cancelar()
    {
        LimpiarFormulario();
        LimpiarMensaje();
    }

    private void LimpiarFormulario()
    {
        formulario = new LineaFormulario();

        editando = false;

        idEdicion = 0;
    }

    private void MostrarExito(string texto)
    {
        mensaje = texto;

        claseMensaje = "alert-success";
    }

    private void MostrarError(string texto)
    {
        mensaje = texto;

        claseMensaje = "alert-danger";
    }

    private void MostrarErrores(
        List<string> errores)
    {
        mensaje = errores.Count > 0
            ? string.Join(" ", errores)
            : "Ocurrió un error.";

        claseMensaje = "alert-danger";
    }

    private void LimpiarMensaje()
    {
        mensaje = string.Empty;
    }

    private class LineaFormulario
    {
        public string Nombre { get; set; }
            = string.Empty;

        public string Descripcion { get; set; }
            = string.Empty;
    }
}