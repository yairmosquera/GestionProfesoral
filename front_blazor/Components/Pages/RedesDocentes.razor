@page "/redes-docentes"
@rendermode InteractiveServer

@using FrontGestion.Servicios
@using Microsoft.AspNetCore.Components
@using System.Net.Http.Json

@inject ServicioRedDocente Servicio
@inject ServicioDocente ServicioDocentes
@inject HttpClient Http

<PageTitle>Redes por Docente</PageTitle>

<h1>Gestión de Redes por Docente</h1>

<p class="text-muted">
    Asocia docentes con redes académicas o de investigación.
</p>

@if (!string.IsNullOrWhiteSpace(mensaje))
{
    <div class="alert @(esError ? "alert-danger" : "alert-success")">
        @mensaje
    </div>
}

<div class="card mb-4">
    <div class="card-body">
        <h4 class="mb-4">
            @(editando ? "Editar asociación" : "Registrar asociación")
        </h4>

        <div class="red-docente-form-grid">

            <div class="campo-red-docente span-6">
                <label class="form-label">Docente</label>

                <select class="form-select" @bind="formulario.Docente" disabled="@editando">
                    <option value="0">Seleccione un docente</option>
                    @foreach (var docente in docentes)
                    {
                        <option value="@docente.Cedula">
                            @docente.Nombres @docente.Apellidos - @docente.Cedula
                        </option>
                    }
                </select>
            </div>

            <div class="campo-red-docente span-6">
                <label class="form-label">Red académica o de investigación</label>

                <select class="form-select" @bind="formulario.Red" disabled="@editando">
                    <option value="0">Seleccione una red</option>
                    @foreach (var red in redes)
                    {
                        <option value="@red.Idr">
                            @red.Nombre
                        </option>
                    }
                </select>
            </div>

            <div class="campo-red-docente span-6">
                <label class="form-label">Fecha de inicio</label>

                <input type="date" class="form-control" @bind="formulario.FechaInicio" @bind:format="yyyy-MM-dd" />
            </div>

            <div class="campo-red-docente span-6">
                <label class="form-label">Fecha de finalización</label>

                <input class="form-control" maxlength="45" placeholder="Ejemplo: 2026-12-31"
                       @bind="formulario.FechaFin" />

                <div class="form-text">
                    Opcional. Puedes dejarla vacía si continúa vinculado.
                </div>
            </div>

            <div class="campo-red-docente span-12">
                <label class="form-label">Actividades destacadas</label>

                <textarea class="form-control actividades-destacadas" rows="4"
                          placeholder="Describe las actividades realizadas en la red..."
                          @bind="formulario.ActDestacadas"></textarea>
            </div>

        </div>

        <div class="botones-formulario-red-docente">
            <button class="btn btn-primary me-2" disabled="@guardando" @onclick="Guardar">
                @(guardando ? "Guardando..." : editando ? "Actualizar" : "Guardar")
            </button>

            <button class="btn btn-secondary" disabled="@guardando" @onclick="Limpiar">
                Limpiar
            </button>
        </div>
    </div>
</div>

<h4 class="mb-3">Redes asociadas a docentes</h4>

@if (cargando)
{
    <p>Cargando asociaciones...</p>
}
else if (relaciones.Count == 0)
{
    <div class="alert alert-info">
        No hay redes asociadas a docentes.
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-bordered align-middle">
            <thead class="table-light">
                <tr>
                    <th>Docente</th>
                    <th>Red</th>
                    <th>Fecha inicio</th>
                    <th>Fecha fin</th>
                    <th>Actividades destacadas</th>
                    <th class="columna-acciones-red-docente">Acciones</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var relacion in relaciones)
                {
                    <tr>
                        <td>@NombreDocente(relacion.Docente)</td>
                        <td>@NombreRed(relacion.Red)</td>
                        <td>@relacion.FechaInicio.ToString("dd/MM/yyyy")</td>
                        <td>
                            @(string.IsNullOrWhiteSpace(relacion.FechaFin)
                                ? "Actualidad"
                                : relacion.FechaFin)
                        </td>
                        <td>@relacion.ActDestacadas</td>

                        <td class="columna-acciones-red-docente">
                            <div class="acciones-red-docente">
                                <button type="button" class="btn btn-warning btn-accion" @onclick="() => Editar(relacion)">
                                    ✏️ Editar
                                </button>

                                <button type="button" class="btn btn-danger btn-accion"
                                        @onclick="() => Eliminar(relacion.Red, relacion.Docente)">
                                    🗑️ Retirar
                                </button>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<style>
    .red-docente-form-grid {
        display: grid;
        grid-template-columns: repeat(12, minmax(0, 1fr));
        column-gap: 20px;
        row-gap: 20px;
        width: 100%;
    }

    .red-docente-form-grid .span-6 {
        grid-column: span 6;
    }

    .red-docente-form-grid .span-12 {
        grid-column: span 12;
    }

    .red-docente-form-grid .campo-red-docente {
        min-width: 0;
    }

    .red-docente-form-grid .form-label {
        display: block;
        margin-bottom: 7px;
        font-size: 13px;
        font-weight: 600;
    }

    .red-docente-form-grid .form-control,
    .red-docente-form-grid .form-select {
        display: block;
        width: 100%;
        max-width: 100%;
        min-width: 0;
        height: 40px;
        padding: 8px 12px;
        font-size: 14px;
        border: 1px solid #cbd5e1;
        border-radius: 6px;
        background-color: #ffffff;
        color: #1e293b;
        box-sizing: border-box;
    }

    .red-docente-form-grid .form-control:focus,
    .red-docente-form-grid .form-select:focus {
        border-color: #2563eb;
        outline: none;
        box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.12);
    }

    .red-docente-form-grid .form-control:disabled,
    .red-docente-form-grid .form-select:disabled {
        background-color: #e5e7eb;
        color: #64748b;
    }

    .red-docente-form-grid .actividades-destacadas {
        height: auto;
        min-height: 110px;
        padding: 12px;
        resize: vertical;
    }

    .red-docente-form-grid .form-text {
        margin-top: 7px;
        font-size: 12px;
        color: #64748b;
    }

    .botones-formulario-red-docente {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        margin-top: 24px;
    }

    .columna-acciones-red-docente {
        width: 240px;
        min-width: 240px;
        vertical-align: middle;
    }

    .acciones-red-docente {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 8px;
        width: 100%;
    }

    .acciones-red-docente .btn-accion {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 100%;
        min-height: 38px;
        padding: 7px 8px;
        border-radius: 6px;
        font-size: 12px;
        font-weight: 600;
        white-space: nowrap;
        transition: background-color 0.2s ease,
            transform 0.2s ease;
    }

    .acciones-red-docente .btn-warning {
        background-color: #f59e0b;
        border-color: #f59e0b;
        color: #ffffff;
    }

    .acciones-red-docente .btn-warning:hover {
        background-color: #d97706;
        border-color: #d97706;
        color: #ffffff;
    }

    .acciones-red-docente .btn-danger {
        background-color: #dc2626;
        border-color: #dc2626;
        color: #ffffff;
    }

    .acciones-red-docente .btn-danger:hover {
        background-color: #b91c1c;
        border-color: #b91c1c;
        color: #ffffff;
    }

    .acciones-red-docente .btn-accion:hover {
        transform: translateY(-1px);
    }

    @@media (max-width: 600px) {

        .red-docente-form-grid .span-6,
        .red-docente-form-grid .span-12 {
            grid-column: span 12;
        }

        .columna-acciones-red-docente {
            width: 220px;
            min-width: 220px;
        }
    }
</style>

@code {
    [SupplyParameterFromQuery(Name = "docente")]
    public int? DocenteDesdeUrl { get; set; }

    private sealed class RedCatalogoDto
    {
        public int Idr { get; set; }
        public string Nombre { get; set; } = string.Empty;
        public bool Activo { get; set; } = true;
    }

    private List<RedDocenteDto> relaciones = new();
    private List<DocenteDto> docentes = new();
    private List<RedCatalogoDto> redes = new();

    private RedDocenteDto formulario = new();

    private bool cargando = true;
    private bool guardando;
    private bool editando;
    private bool esError;
    private string mensaje = "";

    protected override async Task OnInitializedAsync()
    {
        await Cargar();

        SeleccionarDocenteDesdeUrl();
    }

    private async Task Cargar()
    {
        cargando = true;

        try
        {
            docentes = await ServicioDocentes.Listar();

            // Se consulta el catálogo existente de redes.
            var catalogo = await Http.GetFromJsonAsync<List<RedCatalogoDto>>(
                "api/redes");

            redes = catalogo?.Where(r => r.Activo).ToList() ?? new();

            relaciones = await Servicio.Listar();
        }
        catch (Exception ex)
        {
            esError = true;
            mensaje = $"No fue posible cargar la información: {ex.Message}";
        }
        finally
        {
            cargando = false;
        }
    }

    private string NombreDocente(int cedula)
    {
        var docente = docentes.FirstOrDefault(
            d => d.Cedula == cedula);

        return docente is null
            ? $"Cédula: {cedula}"
            : $"{docente.Nombres} {docente.Apellidos}";
    }

    private string NombreRed(int id)
    {
        var red = redes.FirstOrDefault(r => r.Idr == id);

        return red is null ? $"Red {id}" : red.Nombre;
    }

    private async Task Guardar()
    {
        if (guardando)
            return;

        if (formulario.Red <= 0 ||
            formulario.Docente <= 0 ||
            formulario.FechaInicio == default)
        {
            esError = true;
            mensaje = "Seleccione un docente, una red y la fecha de inicio.";
            return;
        }

        guardando = true;

        try
        {
            var resultado = await Servicio.Guardar(formulario, editando);

            esError = !resultado.Ok;
            mensaje = resultado.Mensaje;

            if (resultado.Ok)
            {
                LimpiarFormulario();
                await Cargar();
            }
        }
        catch (Exception)
        {
            esError = true;
            mensaje = "No fue posible comunicarse con la API.";
        }
        finally
        {
            guardando = false;
        }
    }

    private void Editar(RedDocenteDto relacion)
    {
        formulario = new RedDocenteDto
        {
            Red = relacion.Red,
            Docente = relacion.Docente,
            FechaInicio = relacion.FechaInicio,
            FechaFin = relacion.FechaFin,
            ActDestacadas = relacion.ActDestacadas,
            Activo = relacion.Activo
        };

        editando = true;
        mensaje = "";
    }

    private async Task Eliminar(int red, int docente)
    {
        try
        {
            var resultado = await Servicio.Eliminar(red, docente);

            esError = !resultado.Ok;
            mensaje = resultado.Mensaje;

            if (resultado.Ok)
            {
                if (editando &&
                    formulario.Red == red &&
                    formulario.Docente == docente)
                {
                    LimpiarFormulario();
                }

                await Cargar();
            }
        }
        catch (Exception)
        {
            esError = true;
            mensaje = "No fue posible retirar la asociación.";
        }
    }

    private void Limpiar()
    {
        LimpiarFormulario();
        mensaje = "";
    }

    private void LimpiarFormulario()
    {
        formulario = new RedDocenteDto();
        editando = false;
        SeleccionarDocenteDesdeUrl();
    }

    private void SeleccionarDocenteDesdeUrl()
    {
        if (DocenteDesdeUrl.HasValue &&
            docentes.Any(d => d.Cedula == DocenteDesdeUrl.Value))
        {
            formulario.Docente = DocenteDesdeUrl.Value;
        }
    }
}
