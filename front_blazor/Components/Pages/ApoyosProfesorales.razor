@page "/apoyos-profesorales"
@rendermode InteractiveServer

@using System.Text.Json
@using FrontGestion.Servicios
@inject ServicioApoyoProfesoral Servicio
@inject ServicioEstudioRealizado ServicioEstudios
@inject ILogger<ApoyosProfesorales> Logger

<PageTitle>Apoyos Profesorales</PageTitle>

<h1>Apoyos Profesorales</h1>
<p class="text-muted">Administra los apoyos asociados a estudios realizados.</p>

@if (!string.IsNullOrWhiteSpace(mensaje))
{
    <div class="alert @(esError ? "alert-danger" : "alert-success")">@mensaje</div>
}

<div class="card mb-4">
    <div class="card-body">
        <h4 class="mb-3">@(editando ? "Editar apoyo" : "Registrar apoyo")</h4>
        <div class="row g-3">
            <div class="col-md-6">
                <label class="form-label">Estudio</label>
                <select class="form-select" @bind="formulario.Estudios" disabled="@editando">
                    <option value="0">Seleccione un estudio</option>
                    @foreach (var estudio in estudios)
                    {
                        <option value="@estudio.Id">@estudio.Titulo - @estudio.Universidad</option>
                    }
                </select>
            </div>
            <div class="col-md-6">
                <label class="form-label">¿Cuenta con apoyo?</label>
                <select class="form-select" @bind="formulario.ConApoyo">
                    <option value="1">Sí</option>
                    <option value="0">No</option>
                </select>
            </div>
            <div class="col-md-6">
                <label class="form-label">Institución</label>
                <input class="form-control" maxlength="45" @bind="formulario.Institucion" />
            </div>
            <div class="col-md-6">
                <label class="form-label">Tipo de apoyo</label>
                <input class="form-control" maxlength="45" @bind="formulario.Tipo" />
            </div>
        </div>
        <div class="mt-3">
            <button class="btn btn-primary me-2" disabled="@guardando" @onclick="Guardar">
                @(guardando ? "Guardando..." : editando ? "Actualizar" : "Guardar")
            </button>
            <button class="btn btn-secondary" disabled="@guardando" @onclick="Limpiar">Limpiar</button>
        </div>
    </div>
</div>

<h4 class="mb-3">Apoyos registrados</h4>
@if (cargando)
{
    <p>Cargando apoyos...</p>
}
else if (apoyos.Count == 0)
{
    <div class="alert alert-info">No hay apoyos profesorales registrados.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-bordered align-middle">
            <thead class="table-light">
                <tr><th>Estudio</th><th>Con apoyo</th><th>Institución</th><th>Tipo</th><th>Acciones</th></tr>
            </thead>
            <tbody>
                @foreach (var apoyo in apoyos)
                {
                    <tr>
                        <td>@TituloEstudio(apoyo.Estudios)</td>
                        <td>@(apoyo.ConApoyo == 1 ? "Sí" : "No")</td>
                        <td>@apoyo.Institucion</td>
                        <td>@apoyo.Tipo</td>
                        <td>
                            <button class="btn btn-warning btn-sm me-1" @onclick="() => Editar(apoyo)">Editar</button>
                            <button class="btn btn-danger btn-sm" @onclick="() => Eliminar(apoyo.Estudios)">Retirar</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private List<EstudioRealizadoDto> estudios = new();
    private List<ApoyoProfesoralDto> apoyos = new();
    private ApoyoProfesoralDto formulario = new();
    private string mensaje = string.Empty;
    private bool esError;
    private bool cargando = true;
    private bool guardando;
    private bool editando;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            estudios = await ServicioEstudios.Listar();
            apoyos = await Servicio.Listar();
        }
        catch (Exception ex) when (ex is HttpRequestException or JsonException)
        {
            Logger.LogError(ex, "No fue posible cargar los apoyos profesorales.");
            MostrarError("No fue posible cargar los estudios o apoyos profesorales.");
        }
        finally
        {
            cargando = false;
        }
    }

    private string TituloEstudio(int id)
    {
        var estudio = estudios.FirstOrDefault(x => x.Id == id);
        return estudio is null ? id.ToString() : $"{estudio.Titulo} - {estudio.Universidad}";
    }

    private void Editar(ApoyoProfesoralDto apoyo)
    {
        formulario = new ApoyoProfesoralDto
        {
            Estudios = apoyo.Estudios,
            ConApoyo = apoyo.ConApoyo,
            Institucion = apoyo.Institucion,
            Tipo = apoyo.Tipo
        };
        editando = true;
        mensaje = string.Empty;
    }

    private async Task Guardar()
    {
        guardando = true;
        try
        {
            var resultado = await Servicio.Guardar(formulario, editando);
            mensaje = resultado.Mensaje;
            esError = !resultado.Ok;
            if (resultado.Ok)
            {
                Limpiar();
                apoyos = await Servicio.Listar();
            }
        }
        catch (Exception ex) when (ex is HttpRequestException or JsonException)
        {
            Logger.LogError(ex, "No fue posible guardar el apoyo profesoral.");
            MostrarError("No fue posible comunicarse con la API para guardar el apoyo.");
        }
        finally
        {
            guardando = false;
        }
    }

    private async Task Eliminar(int estudiosId)
    {
        try
        {
            var resultado = await Servicio.Eliminar(estudiosId);
            mensaje = resultado.Mensaje;
            esError = !resultado.Ok;
            if (resultado.Ok)
                apoyos = await Servicio.Listar();
        }
        catch (Exception ex) when (ex is HttpRequestException or JsonException)
        {
            Logger.LogError(ex, "No fue posible retirar el apoyo profesoral.");
            MostrarError("No fue posible comunicarse con la API para retirar el apoyo.");
        }
    }

    private void Limpiar()
    {
        formulario = new();
        editando = false;
    }

    private void MostrarError(string texto)
    {
        mensaje = texto;
        esError = true;
    }
}
